---
import SectionHead from '~/components/SectionHead.astro';
---

<section id="screens" class="u-section screens">
  <div class="u-shell">
    <SectionHead
      eyebrow="Every screen size"
      title="Phone, foldable, desktop."
      lede="The same Rust codebase adapts as the window changes: a focused rooms list on a phone, and room info panes beside the conversation on a tablet or foldable."
    />
    <div class="screens__grid">
      <figure class="screens__fig screens__fig--phone">
        <img
          src="/images/robrix-mobile-dark.webp"
          alt="Robrix on a phone in the dark theme: the rooms list with filter bubbles for Rooms, Unreads and Mentions, a sync status tooltip and a floating bottom bar."
          width="700"
          height="1424"
          loading="lazy"
          decoding="async"
        />
        <figcaption>Mobile rooms list in the dark theme.</figcaption>
      </figure>
      <figure class="screens__fig screens__fig--tablet">
        <img
          src="/images/robrix-foldable-light.webp"
          alt="Robrix on a foldable or tablet in the light theme: a room with the Threads and Members info panes open beside the conversation."
          width="1200"
          height="1233"
          loading="lazy"
          decoding="async"
        />
        <figcaption>Foldable or tablet view of a room with info panes, in the light theme.</figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .screens {
    border-top: 1px solid var(--w-line);
  }

  /* Column widths follow each image's aspect ratio (700x1424 and 1200x1233),
     so both screenshots render at the same height at every viewport width. */
  .screens__grid {
    display: grid;
    grid-template-columns: 0.4916fr 0.9732fr;
    gap: clamp(1rem, 4vw, 3.5rem);
    align-items: start;
    max-width: 64rem;
    margin: 0 auto;
  }

  .screens__fig {
    margin: 0;
    min-width: 0;
  }

  .screens__fig img {
    width: 100%;
    height: auto;
    filter: drop-shadow(0 0 28px color-mix(in srgb, var(--w-phos) 14%, transparent));
  }

  .screens__fig figcaption {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    color: var(--w-faint);
    margin-top: 0.875rem;
  }
</style>
