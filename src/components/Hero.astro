---
import { Icon } from 'astro-icon/components';
import { RELEASE } from '~/data/site';
---

<section class="hero" aria-labelledby="hero-heading" data-rain-root>
  <canvas class="hero__rain" aria-hidden="true"></canvas>
  <div class="hero__scrim" aria-hidden="true"></div>
  <img class="hero__symbol" src="/images/robrix-code.svg" alt="" width="560" height="560" fetchpriority="high" />

  <div class="u-shell hero__inner">
    <div class="hero__copy">
      <p class="hero__eyebrow"><span aria-hidden="true"></span> Open source. Open conversations.</p>
      <h1 id="hero-heading" class="hero__wordmark u-display">Robrix</h1>
      <p class="hero__headline">Make room for<br /><em>your conversations.</em></p>
      <p class="hero__description">
        A native Matrix client built in Rust. Arrange rooms and threads side by side, with a layout that works for you.
      </p>
      <div class="hero__actions">
        <a class="u-btn u-btn--primary" href="/download">
          <Icon name="tabler:download" width="16" height="16" />
          Download Robrix
        </a>
        <a class="hero__explore" href="#dock">
          Explore the layout <Icon name="tabler:arrow-down-right" width="17" height="17" />
        </a>
      </div>
      <p class="hero__release">
        <span class="hero__version">{RELEASE.tag}</span>
        <span class="hero__separator" aria-hidden="true">/</span>
        <span>macOS · Linux · Windows · Android · iOS</span>
      </p>
    </div>
  </div>

  <div class="hero__foot u-shell">
    <a href="#dock" class="hero__scroll"><Icon name="tabler:arrow-down" width="14" height="14" /> Find your flow</a>
    <button class="hero__motion" type="button" data-rain-pause>Pause rain</button>
  </div>
</section>

<style>
  .hero {
    --hero-accent: #ff5865;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: clamp(44rem, 100svh, 60rem);
    display: flex;
    align-items: center;
    padding-block: 7.5rem 6rem;
    background: #07090a;
    color: #e8ecea;
    border-bottom: 1px solid #1c3023;
  }

  .hero::after {
    content: '';
    position: absolute;
    inset: auto auto 0 0;
    width: clamp(8rem, 22vw, 22rem);
    height: 2px;
    background: var(--hero-accent);
    box-shadow: 0 0 22px rgb(255 88 101 / 0.45);
    pointer-events: none;
  }

  .hero__rain,
  .hero__scrim {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .hero__rain { z-index: -3; opacity: 0.82; }
  .hero__scrim {
    z-index: -2;
    background: radial-gradient(ellipse 35% 40% at 96% 74%, rgb(255 50 75 / 0.11), transparent 75%),
      linear-gradient(90deg, rgb(7 9 10 / 0.9), rgb(7 9 10 / 0.75) 36%, rgb(7 9 10 / 0.08) 75%),
      linear-gradient(0deg, #07090a, transparent 20%, transparent 85%, rgb(7 9 10 / 0.4));
  }

  .hero__symbol {
    position: absolute;
    z-index: -1;
    width: clamp(20rem, 42vw, 39rem);
    height: auto;
    top: 50%;
    left: 57%;
    transform: translateY(-50%);
    opacity: 0.9;
    pointer-events: none;
    filter: drop-shadow(0 0 45px rgb(0 255 65 / 0.16));
    animation: hero-materialize 1.6s ease both;
  }

  .hero__inner { position: relative; }
  .hero__copy { max-width: 40rem; }
  .hero__copy > * { animation: u-rise 0.8s cubic-bezier(0.22, 1, 0.36, 1) both; }

  .hero__eyebrow {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin: 0 0 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #a8c0b0;
  }
  .hero__eyebrow span {
    width: 22px;
    height: 2px;
    flex: 0 0 auto;
    background: var(--hero-accent);
    box-shadow: 0 0 12px rgb(255 88 101 / 0.45);
  }

  .hero__wordmark {
    margin: 0 0 2rem;
    font-size: clamp(6rem, 13vw, 12rem);
    line-height: 0.9;
    letter-spacing: -0.025em;
    color: #effff2;
    text-shadow: 0 0 65px rgb(0 255 65 / 0.12);
    animation-delay: 0.08s;
  }
  .hero__headline {
    font-size: clamp(1.75rem, 3.4vw, 3rem);
    font-weight: 500;
    line-height: 1.17;
    letter-spacing: -0.04em;
    margin: 0 0 1.25rem;
    animation-delay: 0.15s;
  }
  .hero__headline em { font-style: normal; color: #00ff41; }
  .hero__description {
    max-width: 43ch;
    font-size: 1rem;
    font-weight: 300;
    line-height: 1.7;
    color: #a8b8ad;
    margin: 0 0 1.75rem;
    animation-delay: 0.23s;
  }
  .hero__actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.25rem 1.75rem;
    animation-delay: 0.3s;
  }
  .hero .u-btn--primary {
    background: #00ff41;
    color: #04160b;
    box-shadow: 0 0 40px rgb(0 255 65 / 0.18);
  }
  .hero__explore {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding-block: 0.75rem;
    color: #d0e2d6;
    transition: color 0.2s ease;
  }
  .hero__explore:hover { color: #00ff41; }
  .hero__explore :global(svg) { color: var(--hero-accent); transition: transform 0.2s ease; }
  .hero__explore:hover :global(svg) { transform: translate(2px, 2px); }
  .hero__release {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.5rem 0 0;
    color: #8a9e92;
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.035em;
    animation-delay: 0.36s;
  }
  .hero__separator { color: #3b5544; }
  .hero__version { color: var(--hero-accent); }
  .hero__foot {
    position: absolute;
    bottom: 1.5rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .hero__scroll,
  .hero__motion {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding-block: 0.625rem;
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #99ada1;
  }
  .hero__motion { background: none; border: 0; cursor: pointer; }
  .hero__motion[hidden] { display: none; }
  .hero__scroll:hover,
  .hero__motion:hover { color: #00ff41; }
  .hero :focus-visible { outline-color: #00ff41; }

  @keyframes hero-materialize {
    from { opacity: 0; filter: blur(12px); }
    to { opacity: 0.9; filter: blur(0); }
  }

  @media (max-width: 760px) {
    .hero { min-height: 100svh; padding-block: 7rem 6rem; }
    .hero__symbol { left: 42%; top: 32%; width: 28rem; opacity: 0.22; animation: none; }
    .hero__scrim { background: radial-gradient(ellipse 60% 32% at 100% 42%, rgb(255 50 75 / 0.09), transparent 75%),
      linear-gradient(90deg, rgb(7 9 10 / 0.86), rgb(7 9 10 / 0.3)),
      linear-gradient(0deg, #07090a, transparent 90%); }
    .hero__copy { max-width: 32rem; }
    .hero__wordmark { font-size: clamp(6rem, 21vw, 10rem); margin-bottom: 1.75rem; }
    .hero__description { font-size: 0.9375rem; max-width: 35ch; }
    .hero__headline { font-size: clamp(1.75rem, 6vw, 2.5rem); }
    .hero__release { max-width: 35ch; line-height: 1.8; }
    .hero__separator { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__symbol,
    .hero__copy > * { animation: none; }
  }
</style>

<script>
  const hero = document.querySelector<HTMLElement>('[data-rain-root]');
  if (hero) {
    const canvas = hero.querySelector<HTMLCanvasElement>('.hero__rain')!;
    const pauseButton = hero.querySelector<HTMLButtonElement>('[data-rain-pause]');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    let paused = false;

    // Pace drawing, and stop work while the hero or browser tab is hidden.
    const paced = (stepMs: number, frame: () => void) => {
      let raf = 0;
      let timer = 0;
      let onScreen = true;
      const awake = () => !reduced.matches && !paused && onScreen && document.visibilityState === 'visible';

      const run = () => {
        raf = 0;
        if (!awake()) return;
        frame();
        queue();
      };

      const queue = () => {
        if (timer || raf || !awake()) return;
        timer = window.setTimeout(() => {
          timer = 0;
          if (awake()) raf = requestAnimationFrame(run);
        }, stepMs);
      };

      const halt = () => {
        if (timer) {
          clearTimeout(timer);
          timer = 0;
        }
        if (raf) {
          cancelAnimationFrame(raf);
          raf = 0;
        }
      };

      /* rAF stops itself in a hidden tab but setTimeout only slows down, so the
         pacing timer has to be told to stand down as well. */
      const sync = () => (awake() ? queue() : halt());
      document.addEventListener('visibilitychange', sync);
      new IntersectionObserver(
        ([entry]) => {
          onScreen = entry.isIntersecting;
          sync();
        },
        { threshold: 0.02 }
      ).observe(hero);

      queue();
      return {
        sync,
      };
    };

    const GLYPHS = 'ｱｲｳｴｵｶｷｸｹｺｻｼｽｾｿﾀﾁﾂﾃﾄﾅﾆﾇﾈﾉﾊﾋﾌﾍﾎﾏﾐﾑﾒﾓﾔﾕﾖﾗﾘﾙﾚﾛﾜﾝ0123456789:.=*+-<>';
    const ctx = canvas.getContext('2d', { alpha: false });

    if (ctx) {
      /* The rain is soft, out of focus and sits behind a scrim, so a full retina
         backing store buys nothing visible and costs 44% more pixels to fill. */
      const dpr = Math.min(window.devicePixelRatio || 1, 1.5);
      const fontSpec = (px: number) => `${px}px 'JetBrains Mono Variable', monospace`;
      const glyph = () => (Math.random() * GLYPHS.length) | 0;

      /* Three depth layers. Smaller glyphs read as further off: packed tighter,
         falling slower, dimmer. The big near layer is what the eye catches. */
      type Layer = {
        font: number;
        pitch: number;
        speed: number;
        respawn: number;
        head: string;
        body: string;
        faint: string;
        drops: number[];
      };

      const LAYERS: Layer[] = [
        {
          font: 12,
          pitch: 66,
          speed: 7,
          respawn: 0.93,
          head: 'rgba(190,255,212,0.8)',
          body: 'rgba(30,255,95,0.5)',
          faint: 'rgba(0,255,65,0.28)',
          drops: [],
        },
        {
          font: 18,
          pitch: 96,
          speed: 11,
          respawn: 0.93,
          head: 'rgba(198,255,216,1)',
          body: 'rgba(50,255,112,0.78)',
          faint: 'rgba(0,255,65,0.44)',
          drops: [],
        },
        {
          font: 28,
          pitch: 170,
          speed: 16,
          respawn: 0.95,
          head: 'rgba(214,255,229,1)',
          body: 'rgba(72,255,128,0.9)',
          faint: 'rgba(0,255,65,0.55)',
          drops: [],
        },
      ];

      /* Columns that never fall. They sit still and re-roll a character now and
         then, so the gaps between the streams keep moving. */
      type Strip = { x: number; font: number; top: number; cells: number[] };
      let strips: Strip[] = [];

      let w = 0;
      let h = 0;

      const resize = () => {
        const r = canvas.getBoundingClientRect();
        if (!r.width || !r.height) return;
        w = r.width;
        h = r.height;
        canvas.width = Math.floor(w * dpr);
        canvas.height = Math.floor(h * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        ctx.fillStyle = '#07090a';
        ctx.fillRect(0, 0, w, h);

        /* Seed across [-h, h] so roughly half of every layer is already falling
           on screen at first paint instead of raining in from nothing. */
        for (const l of LAYERS) {
          l.drops = Array.from(
            { length: Math.ceil(w / l.pitch) + 1 },
            () => Math.random() * 2 * h - h
          );
        }

        /* One strip per vertical slice of the canvas, and a shuffled band index
           to spread them down the height too. Purely random placement clumps —
           this covers the canvas without falling into a visible pattern. */
        const count = Math.max(8, Math.round(w / 62));
        const slot = w / count;
        const BANDS = 3;
        const bands = Array.from({ length: count }, (_, i) => i % BANDS);
        for (let i = bands.length - 1; i > 0; i--) {
          const j = (Math.random() * (i + 1)) | 0;
          const t = bands[i];
          bands[i] = bands[j];
          bands[j] = t;
        }

        strips = Array.from({ length: count }, (_, i) => {
          const font = LAYERS[(Math.random() * LAYERS.length) | 0].font;
          const rows = 4 + ((Math.random() * 9) | 0);
          const bandH = Math.max(1, (h - rows * font) / BANDS);
          return {
            x: i * slot + Math.random() * Math.max(1, slot - font),
            font,
            top: bands[i] * bandH + Math.random() * bandH,
            cells: Array.from({ length: rows }, glyph),
          };
        });
        /* grouped by size so the draw loop only switches ctx.font a few times */
        strips.sort((a, b) => a.font - b.font);
      };

      let rt: number;
      window.addEventListener('resize', () => {
        clearTimeout(rt);
        rt = window.setTimeout(paintStill, 160);
      });

      const draw = () => {
        ctx.fillStyle = 'rgba(7,9,10,0.11)';
        ctx.fillRect(0, 0, w, h);
        ctx.textBaseline = 'top';

        for (const l of LAYERS) {
          ctx.font = fontSpec(l.font);
          const drops = l.drops;
          for (let i = 0; i < drops.length; i++) {
            const x = i * l.pitch;
            ctx.fillStyle = l.head;
            ctx.fillText(GLYPHS[glyph()], x, drops[i]);
            ctx.fillStyle = l.body;
            ctx.fillText(GLYPHS[glyph()], x, drops[i] - l.font);
            ctx.fillStyle = l.faint;
            ctx.fillText(GLYPHS[glyph()], x, drops[i] - l.font * 2);
            drops[i] += l.speed;
            /* Respawn chance per frame once a column runs off the bottom.
               This governs how many streams are falling at any moment. */
            if (drops[i] > h && Math.random() > l.respawn) drops[i] = -l.font * 2;
          }
        }

        let stripFont = 0;
        for (const s of strips) {
          if (s.font !== stripFont) {
            stripFont = s.font;
            ctx.font = fontSpec(stripFont);
          }
          for (let r = 0; r < s.cells.length; r++) {
            /* A cell that just turned over flares, then decays with the canvas
               fade. That flicker is the whole point of these. */
            const turned = Math.random() < 0.07;
            if (turned) s.cells[r] = glyph();
            ctx.fillStyle = turned ? 'rgba(196,255,214,0.5)' : 'rgba(0,255,65,0.075)';
            ctx.fillText(GLYPHS[s.cells[r]], s.x, s.top + r * s.font);
          }
          /* and once in a while the whole strip slips a row, like a bad frame */
          if (Math.random() < 0.005) {
            const slipped = s.top + (Math.random() < 0.5 ? -s.font : s.font);
            if (slipped > 0 && slipped + s.cells.length * s.font < h) s.top = slipped;
          }
        }
      };

      // Seed complete trails so reduced motion has the same visual identity.
      const paintStill = () => {
        resize();
        for (let i = 0; i < 24; i++) draw();
      };
      paintStill();
      const animation = paced(60, draw);
      const syncMotion = () => {
        hero.dataset.rainPaused = String(paused || reduced.matches);
        if (pauseButton) {
          pauseButton.hidden = reduced.matches;
          pauseButton.textContent = paused ? 'Resume rain' : 'Pause rain';
        }
        animation.sync();
      };
      pauseButton?.addEventListener('click', () => {
        paused = !paused;
        syncMotion();
      });
      reduced.addEventListener('change', syncMotion);
      syncMotion();
    }
  }
</script>
