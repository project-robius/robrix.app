---
import { Icon } from 'astro-icon/components';
import { RELEASE, CONTRAST } from '~/data/site';
---

<section class="hero" data-seam-root aria-labelledby="hero-heading">
  <h1 id="hero-heading" class="sr-only">
    Robrix — a Matrix chat client written from scratch in Rust. Choose your reality.
  </h1>

  {/* Underneath: the real world. Revealed as the seam moves left. */}
  <div class="hero__pane hero__pane--real">
    <canvas class="hero__rain" aria-hidden="true"></canvas>
    <div class="hero__inner">
      <p class="hero__tag hero__tag--red">
        <span class="hero__pill"></span> Red pill · the real
      </p>
      <p class="hero__head u-display">Wake<br /><em>up.</em></p>
      <p class="hero__claim">
        Robrix is a Matrix client <strong>written from scratch in Rust</strong>. Dockable tabs keep every room open
        at once. Native on six platforms, from one codebase.
      </p>

      <dl class="hero__meter hero__meter--real">
        {
          CONTRAST.real.map((row) => (
            <div class="hero__row">
              <dt>{row.k}</dt>
              <div class="hero__bar">
                <i style={`width:${row.bar}%`} />
              </div>
              <dd>{row.v}</dd>
            </div>
          ))
        }
      </dl>

      <div class="hero__cta">
        <a class="hero__btn hero__btn--go" href="/download">
          <Icon name="tabler:download" width="16" height="16" />
          Download {RELEASE.version}
        </a>
        <a class="hero__btn hero__btn--line" href="#dock">See the dock</a>
      </div>
    </div>
  </div>

  {/* On top, clipped back to the seam: the simulation. */}
  <div class="hero__pane hero__pane--sim">
    <div class="hero__inner">
      <p class="hero__tag hero__tag--blue">
        <span class="hero__pill"></span> Blue pill · the simulation
      </p>
      <p class="hero__head u-display">Stay<br />asleep.</p>
      <p class="hero__claim">
        Keep the chat client that <strong>ships a whole browser</strong> to draw a text box. Keep waiting on sync.
        Keep one room on screen at a time.
      </p>

      <dl class="hero__meter hero__meter--sim">
        {
          CONTRAST.sim.map((row) => (
            <div class="hero__row">
              <dt>{row.k}</dt>
              <div class="hero__bar">
                <i style={`width:${row.bar}%`} />
              </div>
              <dd>{row.v}</dd>
            </div>
          ))
        }
      </dl>

      <div class="hero__cta">
        <button type="button" class="hero__btn hero__btn--stay" data-stay>Stay in the simulation</button>
      </div>
    </div>
  </div>

  <div class="hero__seam" aria-hidden="true"></div>

  <input
    class="hero__range"
    type="range"
    min="8"
    max="92"
    value="50"
    step="0.5"
    aria-label="Reveal more of the simulation or more of the real world"
  />

  <div class="hero__grip" aria-hidden="true">
    <Icon name="tabler:arrows-horizontal" width="16" height="16" />
  </div>

  <p class="hero__hint" aria-hidden="true">Drag the seam</p>

  <a class="hero__scroll" href="#dock" aria-label="Scroll to the dockable tabs">
    <Icon name="tabler:chevron-down" width="18" height="18" />
  </a>
</section>

<style>
  .hero {
    --seam: 50%;
    --sim-bg: #e8edf2;
    --sim-ink: #46525f;
    --sim-dim: #5e6b7a;
    --sim-blue: #3e7bc4;
    --real-bg: #07090a;
    --real-ink: #e8ecea;
    --real-dim: #a8b3ad;
    --red: #ff2233;
    --phos: #00ff41;

    position: relative;
    min-height: clamp(600px, 100svh, 980px);
    overflow: hidden;
    isolation: isolate;
    touch-action: pan-y;
    cursor: ew-resize;
  }

  /* Copy stays selectable at rest — it is only suppressed for the duration of a
     drag, so sweeping the seam across the panes never leaves a selection
     highlight behind it. */
  .hero[data-dragging='true'],
  .hero[data-dragging='true'] * {
    user-select: none;
    -webkit-user-select: none;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .hero__pane {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .hero__pane--real {
    z-index: 1;
    background: var(--real-bg);
    color: var(--real-ink);
  }

  .hero__pane--sim {
    z-index: 2;
    background: var(--sim-bg);
    color: var(--sim-ink);
    clip-path: inset(0 calc(100% - var(--seam)) 0 0);
  }

  .hero__pane--sim::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      repeating-linear-gradient(0deg, rgb(62 123 196 / 0.055) 0 1px, transparent 1px 46px),
      linear-gradient(170deg, rgb(255 255 255 / 0.7), rgb(199 212 226 / 0.6));
  }

  .hero__rain {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    opacity: 0.72;
  }

  /* The rain has to stay behind the argument, not in it. Content is anchored
     right on desktop and bottom on narrow, so the scrim follows it. */
  .hero__pane--real::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      to left,
      rgb(7 9 10 / 0.74) 0%,
      rgb(7 9 10 / 0.62) 38%,
      rgb(7 9 10 / 0.12) 76%,
      rgb(7 9 10 / 0.4) 100%
    );
  }

  .hero__inner {
    --inner-w: min(40%, 30rem);
    position: absolute;
    z-index: 3;
    top: 50%;
    transform: translateY(-50%);
    width: var(--inner-w);
  }

  /* Each block is centred within its own half rather than pushed out to the
     hero's edge — the block caps at 30rem while the half keeps growing, so
     edge-anchoring drifts further off-centre the wider the screen gets.
     Anchored to the hero, not to the seam, so dragging never shifts the copy.
     The clamp is a floor: it guarantees a gutter once the half gets tight. */
  .hero__pane--sim .hero__inner {
    left: max(clamp(1.25rem, 4vw, 3.5rem), calc((50% - var(--inner-w)) / 2));
  }

  /* Sweeping the seam left hands the real half more room, so the copy re-centres
     in what it actually has. Going right only ever takes room away, and chasing
     that would shove the block into the edge — so past centre the anchor holds
     still, which is what pinning the seam at 50% for that direction buys. */
  .hero__pane--real .hero__inner {
    right: max(clamp(1.25rem, 4vw, 3.5rem), calc((100% - min(var(--seam), 50%) - var(--inner-w)) / 2));
  }

  .hero__tag {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.19em;
    text-transform: uppercase;
    margin: 0 0 1.125rem;
    white-space: nowrap;
  }

  .hero__pill {
    width: 22px;
    height: 11px;
    border-radius: 99px;
    flex: 0 0 auto;
    background: currentColor;
    box-shadow: 0 0 18px currentColor;
  }

  .hero__tag--blue {
    color: var(--sim-blue);
  }
  .hero__tag--red {
    color: var(--red);
  }

  .hero__head {
    font-size: clamp(2.5rem, 5.6vw, 5.25rem);
    margin: 0 0 1.25rem;
  }

  .hero__pane--sim .hero__head {
    /* faded, but still 3:1 against the panel — the simulation is dull, not broken */
    color: #748395;
  }

  .hero__pane--real .hero__head {
    color: #fff;
    text-shadow: 0 0 60px rgb(255 34 51 / 0.3);
  }

  .hero__head em {
    font-style: normal;
    color: var(--red);
  }

  .hero__claim {
    font-size: clamp(0.875rem, 1.15vw, 1.0625rem);
    line-height: 1.55;
    font-weight: 300;
    margin: 0 0 1.5rem;
  }

  .hero__pane--sim .hero__claim {
    color: var(--sim-dim);
  }
  .hero__pane--real .hero__claim {
    color: var(--real-dim);
    text-shadow: 0 1px 10px rgb(7 9 10 / 0.95);
  }
  .hero__pane--sim .hero__claim strong {
    color: var(--sim-ink);
    font-weight: 600;
  }
  .hero__pane--real .hero__claim strong {
    color: #fff;
    font-weight: 600;
  }

  .hero__meter {
    margin: 0 0 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.05em;
  }

  .hero__row {
    display: grid;
    grid-template-columns: 6.5rem minmax(2.5rem, 1fr) auto;
    gap: 0.75rem;
    align-items: center;
  }

  .hero__row dt {
    text-transform: uppercase;
    opacity: 0.62;
    white-space: nowrap;
  }

  .hero__row dd {
    margin: 0;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .hero__bar {
    height: 4px;
    border-radius: 99px;
    position: relative;
    overflow: hidden;
  }

  .hero__bar i {
    position: absolute;
    inset: 0 auto 0 0;
    display: block;
    border-radius: 99px;
    animation: hero-fill 1.1s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @keyframes hero-fill {
    from {
      transform: scaleX(0);
      transform-origin: left;
    }
  }

  .hero__meter--sim .hero__bar {
    background: rgb(70 82 95 / 0.16);
  }
  .hero__meter--sim .hero__bar i {
    background: var(--sim-blue);
  }
  .hero__meter--sim dd {
    color: var(--sim-ink);
  }

  .hero__meter--real .hero__bar {
    background: rgb(255 255 255 / 0.09);
  }
  .hero__meter--real .hero__bar i {
    background: var(--phos);
    box-shadow: 0 0 12px rgb(0 255 65 / 0.6);
  }
  .hero__meter--real dd {
    color: var(--phos);
    text-shadow: 0 1px 8px rgb(7 9 10 / 0.9);
  }

  .hero__meter--real dt {
    text-shadow: 0 1px 8px rgb(7 9 10 / 0.95);
  }

  .hero__cta {
    display: flex;
    gap: 0.625rem;
    flex-wrap: wrap;
  }

  .hero__btn {
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    padding: 0.75rem 1.0625rem;
    border-radius: 4px;
    border: 1px solid transparent;
    cursor: pointer;
    transition:
      transform 0.16s ease,
      box-shadow 0.16s ease,
      background-color 0.16s ease,
      border-color 0.16s ease,
      color 0.16s ease;
  }

  .hero__btn--go {
    background: var(--phos);
    color: #04160b;
    font-weight: 700;
    box-shadow: 0 0 34px rgb(0 255 65 / 0.28);
  }

  .hero__btn--go:hover {
    transform: translateY(-2px);
    box-shadow: 0 0 44px rgb(0 255 65 / 0.42);
  }

  .hero__btn--line {
    border-color: rgb(232 236 234 / 0.22);
    color: var(--real-ink);
  }

  .hero__btn--line:hover {
    border-color: var(--red);
    color: var(--red);
  }

  .hero__btn--stay {
    background: transparent;
    border-color: rgb(70 82 95 / 0.32);
    color: var(--sim-ink);
  }

  .hero__btn--stay:hover {
    border-color: var(--sim-blue);
    color: var(--sim-blue);
  }

  .hero__seam {
    position: absolute;
    inset: 0 auto 0 var(--seam);
    width: 2px;
    z-index: 12;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      rgb(255 34 51 / 0.12),
      var(--red) 24%,
      var(--phos) 76%,
      rgb(0 255 65 / 0.12)
    );
    box-shadow: 0 0 26px rgb(255 34 51 / 0.4);
  }

  /* A real range input keeps the seam keyboard-operable and labelled for
     assistive tech. It is visually hidden rather than stretched over the hero —
     a full-bleed overlay sits on top of the buttons and eats their clicks, and
     paints a resize cursor over the whole thing. The grip is the visual
     affordance, so it takes the focus ring. */
  .hero__range {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    border: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .hero__range:focus-visible ~ .hero__grip {
    outline: 2px solid var(--phos);
    outline-offset: 3px;
  }

  .hero__grip {
    position: absolute;
    top: 50%;
    left: var(--seam);
    transform: translate(-50%, -50%);
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 99px;
    background: #0b0d0e;
    border: 1px solid rgb(255 255 255 / 0.3);
    color: #fff;
    z-index: 13;
    cursor: ew-resize;
    touch-action: none;
    box-shadow: 0 6px 30px rgb(0 0 0 / 0.65);
  }

  .hero__hint {
    position: absolute;
    inset: auto 0 5.5rem 0;
    z-index: 13;
    margin: 0;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgb(150 160 170 / 0.75);
    pointer-events: none;
    mix-blend-mode: difference;
    transition: opacity 0.3s ease;
  }

  .hero[data-touched='true'] .hero__hint {
    opacity: 0;
  }

  .hero__scroll {
    position: absolute;
    inset: auto 0 1.75rem 0;
    z-index: 15;
    width: 40px;
    height: 40px;
    margin-inline: auto;
    display: grid;
    place-items: center;
    border-radius: 99px;
    border: 1px solid rgb(150 160 170 / 0.3);
    color: rgb(150 160 170 / 0.85);
    mix-blend-mode: difference;
    animation: hero-bob 2.6s ease-in-out infinite;
  }

  @keyframes hero-bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(5px);
    }
  }

  /* Narrow: a side-by-side poster has no room, so the seam turns horizontal
     and the two realities stack. */
  @media (max-width: 900px) {
    .hero {
      --seam: 48%;
      /* let the page scroll normally; only the grip starts a drag here */
      touch-action: auto;
      cursor: default;
    }
    .hero__grip {
      cursor: ns-resize;
      width: 52px;
      height: 52px;
    }
    .hero__pane--sim {
      clip-path: inset(0 0 calc(100% - var(--seam)) 0);
    }
    .hero__pane--real::after {
      background: linear-gradient(
        to top,
        rgb(7 9 10 / 0.96) 0%,
        rgb(7 9 10 / 0.9) 42%,
        rgb(7 9 10 / 0.3) 78%,
        rgb(7 9 10 / 0.6) 100%
      );
    }
    .hero__inner {
      width: auto;
      left: clamp(1.25rem, 5vw, 2.5rem);
      right: clamp(1.25rem, 5vw, 2.5rem);
      top: auto;
      transform: none;
    }
    .hero__pane--sim .hero__inner {
      top: 6.5rem;
    }
    /* The seam runs horizontally here, so moving it opens no left/right room to
       re-centre into. Hold the resting offset. */
    .hero__pane--real .hero__inner {
      bottom: 4.5rem;
      right: max(clamp(1.25rem, 4vw, 3.5rem), calc((50% - var(--inner-w)) / 2));
    }
    .hero__head {
      font-size: clamp(2.25rem, 9vw, 3.25rem);
      margin-bottom: 0.875rem;
    }
    .hero__claim {
      margin-bottom: 1rem;
    }
    .hero__meter {
      margin-bottom: 1.125rem;
    }
    .hero__row {
      grid-template-columns: 5.5rem minmax(2rem, 1fr) auto;
    }
    .hero__seam {
      inset: var(--seam) 0 auto 0;
      width: auto;
      height: 2px;
      background: linear-gradient(
        90deg,
        rgb(255 34 51 / 0.12),
        var(--red) 24%,
        var(--phos) 76%,
        rgb(0 255 65 / 0.12)
      );
    }
    .hero__grip {
      top: var(--seam);
      left: 50%;
    }
    .hero__hint,
    .hero__scroll {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .hero__claim {
      display: none;
    }
    .hero__meter {
      font-size: 0.5625rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__scroll {
      animation: none;
    }
    .hero__bar i {
      animation: none;
    }
  }
</style>

<script>
  const hero = document.querySelector<HTMLElement>('[data-seam-root]');
  if (hero) {
    const range = hero.querySelector<HTMLInputElement>('.hero__range')!;
    const stay = hero.querySelector<HTMLButtonElement>('[data-stay]');
    const canvas = hero.querySelector<HTMLCanvasElement>('.hero__rain')!;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    /* ---- the seam ---- */
    const grip = hero.querySelector<HTMLElement>('.hero__grip')!;
    const vertical = window.matchMedia('(max-width: 900px)');

    const setSeam = (pct: number) => {
      hero.style.setProperty('--seam', `${pct}%`);
      range.value = String(pct);
    };

    /* Keyboard and assistive tech drive the same value. */
    range.addEventListener('input', () => {
      hero.dataset.touched = 'true';
      hero.style.setProperty('--seam', `${range.value}%`);
    });

    /* Dragging is handled on the hero itself, not on an overlay: an element
       stretched across the hero would sit above the buttons and swallow every
       click meant for them. */
    let dragging = false;

    const pctFrom = (e: PointerEvent) => {
      const r = hero.getBoundingClientRect();
      const raw = vertical.matches
        ? ((e.clientY - r.top) / r.height) * 100
        : ((e.clientX - r.left) / r.width) * 100;
      return Math.max(8, Math.min(92, raw));
    };

    hero.addEventListener('pointerdown', (e) => {
      const target = e.target as HTMLElement;
      /* never steal a click from a link or a button */
      if (target.closest('a, button')) return;
      /* on narrow screens the seam and the page scroll share an axis, so only
         the grip starts a drag */
      if (vertical.matches && !target.closest('.hero__grip')) return;

      /* stops the browser starting a text selection or a drag image */
      e.preventDefault();

      dragging = true;
      hero.dataset.touched = 'true';
      hero.dataset.dragging = 'true';
      hero.setPointerCapture(e.pointerId);
      setSeam(pctFrom(e));
    });

    hero.addEventListener('pointermove', (e) => {
      if (dragging) setSeam(pctFrom(e));
    });

    const endDrag = () => {
      dragging = false;
      delete hero.dataset.dragging;
      /* clear anything the browser managed to select before preventDefault ran */
      const sel = window.getSelection();
      if (sel && !sel.isCollapsed && hero.contains(sel.anchorNode)) sel.removeAllRanges();
    };
    hero.addEventListener('pointerup', endDrag);
    hero.addEventListener('pointercancel', endDrag);

    /* the grip is the affordance on narrow screens, so give it focus styling */
    grip.addEventListener('pointerdown', () => range.focus({ preventScroll: true }));

    const glideTo = (target: number) => {
      const from = Number(range.value);
      const start = performance.now();
      const step = (now: number) => {
        const t = Math.min((now - start) / 520, 1);
        const eased = 1 - Math.pow(1 - t, 3);
        setSeam(from + (target - from) * eased);
        if (t < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    };

    /* Choosing the blue pill really does put you in the simulation. */
    stay?.addEventListener('click', () => {
      /* delegate to the header's blue pill so there is one code path for
         choosing a reality, and one place that persists it */
      document.querySelector<HTMLButtonElement>('[data-world-set="sim"]')?.click();
    });

    /* Choosing a pill anywhere on the page uncovers that reality here. Without
       this, picking blue leaves the simulation covering the download button with
       no way back except dragging. */
    document.documentElement.addEventListener('worldchange', (e) => {
      const { world, userInitiated } = (e as CustomEvent).detail;
      if (!userInitiated) return;
      hero.dataset.touched = 'true';
      const target = world === 'sim' ? 88 : 24;
      if (reduced) setSeam(target);
      else glideTo(target);
    });

    /* Both animations advance far slower than the display refreshes. Driving
       them from a plain rAF loop meant ~85% of callbacks woke the main thread
       only to reschedule, so instead they wait on a timer and spend a rAF on the
       frames they actually mean to paint — and stand down entirely when the hero
       is off screen or the tab is in the background. */
    const paced = (stepMs: number, frame: () => void) => {
      let raf = 0;
      let timer = 0;
      let onScreen = true;
      let enabled = true;

      const awake = () => enabled && onScreen && document.visibilityState === 'visible';

      const run = () => {
        raf = 0;
        if (!awake()) return;
        frame();
        queue();
      };

      const queue = () => {
        if (timer || raf || !awake()) return;
        timer = window.setTimeout(() => {
          timer = 0;
          if (awake()) raf = requestAnimationFrame(run);
        }, stepMs);
      };

      const halt = () => {
        if (timer) {
          clearTimeout(timer);
          timer = 0;
        }
        if (raf) {
          cancelAnimationFrame(raf);
          raf = 0;
        }
      };

      /* rAF stops itself in a hidden tab but setTimeout only slows down, so the
         pacing timer has to be told to stand down as well. */
      const sync = () => (awake() ? queue() : halt());
      document.addEventListener('visibilitychange', sync);
      new IntersectionObserver(
        ([entry]) => {
          onScreen = entry.isIntersecting;
          sync();
        },
        { threshold: 0.02 }
      ).observe(hero);

      queue();
      return {
        stop: () => {
          enabled = false;
          halt();
        },
      };
    };

    /* A slow sway before first interaction, so the control announces itself. */
    if (!reduced) {
      const PERIOD = 2600;
      /* The hint has landed by ~20s; swaying past that is just burning frames at
         someone who has decided not to drag. Stop on the next zero crossing after
         that instead of a flat timeout, so the seam settles back to centre rather
         than freezing mid-swing. */
      const RETIRE = Math.ceil(20000 / (Math.PI * PERIOD)) * Math.PI * PERIOD;
      /* Clocked on time the hero was actually on screen, not wall time: a scroll
         away shouldn't spend the hint on someone who cannot see it, and the sine
         picks up where it left off instead of jumping on the way back. */
      let shown = 0;
      let last = performance.now();
      /* 30fps is ample for a 2.6s sine, and every step writes a custom property
         that re-clips a full-screen pane — that repaint, not the callback, is
         the expensive half. */
      let lastSeam = -1;
      const swaying = paced(1000 / 30, () => {
        const now = performance.now();
        shown += Math.min(now - last, 100);
        last = now;
        if (hero.dataset.touched === 'true') {
          swaying.stop();
          return;
        }
        if (shown >= RETIRE) {
          setSeam(50);
          swaying.stop();
          return;
        }
        const v = Math.round((50 + Math.sin(shown / PERIOD) * 11) * 100) / 100;
        if (v === lastSeam) return;
        lastSeam = v;
        setSeam(v);
      });
    }

    /* ---- rain, on the real side only ---- */
    const GLYPHS = 'ｱｲｳｴｵｶｷｸｹｺｻｼｽｾｿﾀﾁﾂﾃﾄﾅﾆﾇﾈﾉﾊﾋﾌﾍﾎﾏﾐﾑﾒﾓﾔﾕﾖﾗﾘﾙﾚﾛﾜﾝ0123456789:.=*+-<>';
    const ctx = canvas.getContext('2d', { alpha: false });

    if (ctx && !reduced) {
      /* The rain is soft, out of focus and sits behind a scrim, so a full retina
         backing store buys nothing visible and costs 44% more pixels to fill. */
      const dpr = Math.min(window.devicePixelRatio || 1, 1.5);
      const fontSpec = (px: number) => `${px}px 'JetBrains Mono Variable', monospace`;
      const glyph = () => (Math.random() * GLYPHS.length) | 0;

      /* Three depth layers. Smaller glyphs read as further off: packed tighter,
         falling slower, dimmer. The big near layer is what the eye catches. */
      type Layer = {
        font: number;
        pitch: number;
        speed: number;
        respawn: number;
        head: string;
        body: string;
        faint: string;
        drops: number[];
      };

      const LAYERS: Layer[] = [
        {
          font: 12,
          pitch: 66,
          speed: 7,
          respawn: 0.93,
          head: 'rgba(190,255,212,0.8)',
          body: 'rgba(30,255,95,0.5)',
          faint: 'rgba(0,255,65,0.28)',
          drops: [],
        },
        {
          font: 18,
          pitch: 96,
          speed: 11,
          respawn: 0.93,
          head: 'rgba(198,255,216,1)',
          body: 'rgba(50,255,112,0.78)',
          faint: 'rgba(0,255,65,0.44)',
          drops: [],
        },
        {
          font: 28,
          pitch: 170,
          speed: 16,
          respawn: 0.95,
          head: 'rgba(214,255,229,1)',
          body: 'rgba(72,255,128,0.9)',
          faint: 'rgba(0,255,65,0.55)',
          drops: [],
        },
      ];

      /* Columns that never fall. They sit still and re-roll a character now and
         then, so the gaps between the streams keep moving. */
      type Strip = { x: number; font: number; top: number; cells: number[] };
      let strips: Strip[] = [];

      let w = 0;
      let h = 0;

      const resize = () => {
        const r = canvas.getBoundingClientRect();
        if (!r.width || !r.height) return;
        w = r.width;
        h = r.height;
        canvas.width = Math.floor(w * dpr);
        canvas.height = Math.floor(h * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        ctx.fillStyle = '#07090a';
        ctx.fillRect(0, 0, w, h);

        /* Seed across [-h, h] so roughly half of every layer is already falling
           on screen at first paint instead of raining in from nothing. */
        for (const l of LAYERS) {
          l.drops = Array.from(
            { length: Math.ceil(w / l.pitch) + 1 },
            () => Math.random() * 2 * h - h
          );
        }

        /* One strip per vertical slice of the canvas, and a shuffled band index
           to spread them down the height too. Purely random placement clumps —
           this covers the canvas without falling into a visible pattern. */
        const count = Math.max(8, Math.round(w / 62));
        const slot = w / count;
        const BANDS = 3;
        const bands = Array.from({ length: count }, (_, i) => i % BANDS);
        for (let i = bands.length - 1; i > 0; i--) {
          const j = (Math.random() * (i + 1)) | 0;
          const t = bands[i];
          bands[i] = bands[j];
          bands[j] = t;
        }

        strips = Array.from({ length: count }, (_, i) => {
          const font = LAYERS[(Math.random() * LAYERS.length) | 0].font;
          const rows = 4 + ((Math.random() * 9) | 0);
          const bandH = Math.max(1, (h - rows * font) / BANDS);
          return {
            x: i * slot + Math.random() * Math.max(1, slot - font),
            font,
            top: bands[i] * bandH + Math.random() * bandH,
            cells: Array.from({ length: rows }, glyph),
          };
        });
        /* grouped by size so the draw loop only switches ctx.font a few times */
        strips.sort((a, b) => a.font - b.font);
      };

      let rt: number;
      window.addEventListener('resize', () => {
        clearTimeout(rt);
        rt = window.setTimeout(resize, 160);
      });

      resize();
      paced(60, () => {
        ctx.fillStyle = 'rgba(7,9,10,0.11)';
        ctx.fillRect(0, 0, w, h);
        ctx.textBaseline = 'top';

        for (const l of LAYERS) {
          ctx.font = fontSpec(l.font);
          const drops = l.drops;
          for (let i = 0; i < drops.length; i++) {
            const x = i * l.pitch;
            ctx.fillStyle = l.head;
            ctx.fillText(GLYPHS[glyph()], x, drops[i]);
            ctx.fillStyle = l.body;
            ctx.fillText(GLYPHS[glyph()], x, drops[i] - l.font);
            ctx.fillStyle = l.faint;
            ctx.fillText(GLYPHS[glyph()], x, drops[i] - l.font * 2);
            drops[i] += l.speed;
            /* Respawn chance per frame once a column runs off the bottom.
               This governs how many streams are falling at any moment. */
            if (drops[i] > h && Math.random() > l.respawn) drops[i] = -l.font * 2;
          }
        }

        let stripFont = 0;
        for (const s of strips) {
          if (s.font !== stripFont) {
            stripFont = s.font;
            ctx.font = fontSpec(stripFont);
          }
          for (let r = 0; r < s.cells.length; r++) {
            /* A cell that just turned over flares, then decays with the canvas
               fade. That flicker is the whole point of these. */
            const turned = Math.random() < 0.07;
            if (turned) s.cells[r] = glyph();
            ctx.fillStyle = turned ? 'rgba(196,255,214,0.5)' : 'rgba(0,255,65,0.075)';
            ctx.fillText(GLYPHS[s.cells[r]], s.x, s.top + r * s.font);
          }
          /* and once in a while the whole strip slips a row, like a bad frame */
          if (Math.random() < 0.005) {
            const slipped = s.top + (Math.random() < 0.5 ? -s.font : s.font);
            if (slipped > 0 && slipped + s.cells.length * s.font < h) s.top = slipped;
          }
        }
      });
    }
  }
</script>
