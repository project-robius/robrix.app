---
import { Icon } from 'astro-icon/components';
import { RELEASE, CONTRAST } from '~/data/site';
---

<section class="hero" data-seam-root aria-labelledby="hero-heading">
  <h1 id="hero-heading" class="sr-only">
    Robrix — a Matrix chat client written from scratch in Rust. Choose your reality.
  </h1>

  {/* Underneath: the real world. Revealed as the seam moves left. */}
  <div class="hero__pane hero__pane--real">
    <canvas class="hero__rain" aria-hidden="true"></canvas>
    <div class="hero__inner">
      <p class="hero__tag hero__tag--red">
        <span class="hero__pill"></span> Red pill · the real
      </p>
      <p class="hero__head u-display">Wake<br /><em>up.</em></p>
      <p class="hero__claim">
        Robrix is a Matrix client <strong>written from scratch in Rust</strong>. Dockable tabs keep every room open
        at once. Native on six platforms, from one codebase.
      </p>

      <dl class="hero__meter hero__meter--real">
        {
          CONTRAST.real.map((row) => (
            <div class="hero__row">
              <dt>{row.k}</dt>
              <div class="hero__bar">
                <i style={`width:${row.bar}%`} />
              </div>
              <dd>{row.v}</dd>
            </div>
          ))
        }
      </dl>

      <div class="hero__cta">
        <a class="hero__btn hero__btn--go" href="/download">
          <Icon name="tabler:download" width="16" height="16" />
          Download {RELEASE.version}
        </a>
        <a class="hero__btn hero__btn--line" href="#dock">See the dock</a>
      </div>
    </div>
  </div>

  {/* On top, clipped back to the seam: the simulation. */}
  <div class="hero__pane hero__pane--sim">
    <div class="hero__inner">
      <p class="hero__tag hero__tag--blue">
        <span class="hero__pill"></span> Blue pill · the simulation
      </p>
      <p class="hero__head u-display">Stay<br />asleep.</p>
      <p class="hero__claim">
        Keep the chat client that <strong>ships a whole browser</strong> to draw a text box. Keep waiting on sync.
        Keep one room on screen at a time.
      </p>

      <dl class="hero__meter hero__meter--sim">
        {
          CONTRAST.sim.map((row) => (
            <div class="hero__row">
              <dt>{row.k}</dt>
              <div class="hero__bar">
                <i style={`width:${row.bar}%`} />
              </div>
              <dd>{row.v}</dd>
            </div>
          ))
        }
      </dl>

      <div class="hero__cta">
        <button type="button" class="hero__btn hero__btn--stay" data-stay>Stay in the simulation</button>
      </div>
    </div>
  </div>

  <div class="hero__seam" aria-hidden="true"></div>

  <input
    class="hero__range"
    type="range"
    min="8"
    max="92"
    value="50"
    step="0.5"
    aria-label="Reveal more of the simulation or more of the real world"
  />

  <div class="hero__grip" aria-hidden="true">
    <Icon name="tabler:arrows-horizontal" width="16" height="16" />
  </div>

  <p class="hero__hint" aria-hidden="true">Drag the seam</p>

  <a class="hero__scroll" href="#dock" aria-label="Scroll to the dockable tabs">
    <Icon name="tabler:chevron-down" width="18" height="18" />
  </a>
</section>

<style>
  .hero {
    --seam: 50%;
    --sim-bg: #e8edf2;
    --sim-ink: #46525f;
    --sim-dim: #5e6b7a;
    --sim-blue: #3e7bc4;
    --real-bg: #07090a;
    --real-ink: #e8ecea;
    --real-dim: #a8b3ad;
    --red: #ff2233;
    --phos: #00ff41;

    position: relative;
    min-height: clamp(600px, 100svh, 980px);
    overflow: hidden;
    isolation: isolate;
    touch-action: pan-y;
    cursor: ew-resize;
  }

  /* Copy stays selectable at rest — it is only suppressed for the duration of a
     drag, so sweeping the seam across the panes never leaves a selection
     highlight behind it. */
  .hero[data-dragging='true'],
  .hero[data-dragging='true'] * {
    user-select: none;
    -webkit-user-select: none;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .hero__pane {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .hero__pane--real {
    z-index: 1;
    background: var(--real-bg);
    color: var(--real-ink);
  }

  .hero__pane--sim {
    z-index: 2;
    background: var(--sim-bg);
    color: var(--sim-ink);
    clip-path: inset(0 calc(100% - var(--seam)) 0 0);
  }

  .hero__pane--sim::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      repeating-linear-gradient(0deg, rgb(62 123 196 / 0.055) 0 1px, transparent 1px 46px),
      linear-gradient(170deg, rgb(255 255 255 / 0.7), rgb(199 212 226 / 0.6));
  }

  .hero__rain {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    opacity: 0.72;
  }

  /* The rain has to stay behind the argument, not in it. Content is anchored
     right on desktop and bottom on narrow, so the scrim follows it. */
  .hero__pane--real::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      to left,
      rgb(7 9 10 / 0.74) 0%,
      rgb(7 9 10 / 0.62) 38%,
      rgb(7 9 10 / 0.12) 76%,
      rgb(7 9 10 / 0.4) 100%
    );
  }

  .hero__inner {
    --inner-w: min(40%, 30rem);
    position: absolute;
    z-index: 3;
    top: 50%;
    transform: translateY(-50%);
    width: var(--inner-w);
  }

  /* Each block is centred within its own half rather than pushed out to the
     hero's edge — the block caps at 30rem while the half keeps growing, so
     edge-anchoring drifts further off-centre the wider the screen gets.
     Anchored to the hero, not to the seam, so dragging never shifts the copy.
     The clamp is a floor: it guarantees a gutter once the half gets tight. */
  .hero__pane--sim .hero__inner {
    left: max(clamp(1.25rem, 4vw, 3.5rem), calc((50% - var(--inner-w)) / 2));
  }

  .hero__pane--real .hero__inner {
    right: max(clamp(1.25rem, 4vw, 3.5rem), calc((50% - var(--inner-w)) / 2));
  }

  .hero__tag {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.19em;
    text-transform: uppercase;
    margin: 0 0 1.125rem;
    white-space: nowrap;
  }

  .hero__pill {
    width: 22px;
    height: 11px;
    border-radius: 99px;
    flex: 0 0 auto;
    background: currentColor;
    box-shadow: 0 0 18px currentColor;
  }

  .hero__tag--blue {
    color: var(--sim-blue);
  }
  .hero__tag--red {
    color: var(--red);
  }

  .hero__head {
    font-size: clamp(2.5rem, 5.6vw, 5.25rem);
    margin: 0 0 1.25rem;
  }

  .hero__pane--sim .hero__head {
    /* faded, but still 3:1 against the panel — the simulation is dull, not broken */
    color: #748395;
  }

  .hero__pane--real .hero__head {
    color: #fff;
    text-shadow: 0 0 60px rgb(255 34 51 / 0.3);
  }

  .hero__head em {
    font-style: normal;
    color: var(--red);
  }

  .hero__claim {
    font-size: clamp(0.875rem, 1.15vw, 1.0625rem);
    line-height: 1.55;
    font-weight: 300;
    margin: 0 0 1.5rem;
  }

  .hero__pane--sim .hero__claim {
    color: var(--sim-dim);
  }
  .hero__pane--real .hero__claim {
    color: var(--real-dim);
    text-shadow: 0 1px 10px rgb(7 9 10 / 0.95);
  }
  .hero__pane--sim .hero__claim strong {
    color: var(--sim-ink);
    font-weight: 600;
  }
  .hero__pane--real .hero__claim strong {
    color: #fff;
    font-weight: 600;
  }

  .hero__meter {
    margin: 0 0 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.05em;
  }

  .hero__row {
    display: grid;
    grid-template-columns: 6.5rem minmax(2.5rem, 1fr) auto;
    gap: 0.75rem;
    align-items: center;
  }

  .hero__row dt {
    text-transform: uppercase;
    opacity: 0.62;
    white-space: nowrap;
  }

  .hero__row dd {
    margin: 0;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .hero__bar {
    height: 4px;
    border-radius: 99px;
    position: relative;
    overflow: hidden;
  }

  .hero__bar i {
    position: absolute;
    inset: 0 auto 0 0;
    display: block;
    border-radius: 99px;
    animation: hero-fill 1.1s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @keyframes hero-fill {
    from {
      transform: scaleX(0);
      transform-origin: left;
    }
  }

  .hero__meter--sim .hero__bar {
    background: rgb(70 82 95 / 0.16);
  }
  .hero__meter--sim .hero__bar i {
    background: var(--sim-blue);
  }
  .hero__meter--sim dd {
    color: var(--sim-ink);
  }

  .hero__meter--real .hero__bar {
    background: rgb(255 255 255 / 0.09);
  }
  .hero__meter--real .hero__bar i {
    background: var(--phos);
    box-shadow: 0 0 12px rgb(0 255 65 / 0.6);
  }
  .hero__meter--real dd {
    color: var(--phos);
    text-shadow: 0 1px 8px rgb(7 9 10 / 0.9);
  }

  .hero__meter--real dt {
    text-shadow: 0 1px 8px rgb(7 9 10 / 0.95);
  }

  .hero__cta {
    display: flex;
    gap: 0.625rem;
    flex-wrap: wrap;
  }

  .hero__btn {
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    padding: 0.75rem 1.0625rem;
    border-radius: 4px;
    border: 1px solid transparent;
    cursor: pointer;
    transition:
      transform 0.16s ease,
      box-shadow 0.16s ease,
      background-color 0.16s ease,
      border-color 0.16s ease,
      color 0.16s ease;
  }

  .hero__btn--go {
    background: var(--phos);
    color: #04160b;
    font-weight: 700;
    box-shadow: 0 0 34px rgb(0 255 65 / 0.28);
  }

  .hero__btn--go:hover {
    transform: translateY(-2px);
    box-shadow: 0 0 44px rgb(0 255 65 / 0.42);
  }

  .hero__btn--line {
    border-color: rgb(232 236 234 / 0.22);
    color: var(--real-ink);
  }

  .hero__btn--line:hover {
    border-color: var(--red);
    color: var(--red);
  }

  .hero__btn--stay {
    background: transparent;
    border-color: rgb(70 82 95 / 0.32);
    color: var(--sim-ink);
  }

  .hero__btn--stay:hover {
    border-color: var(--sim-blue);
    color: var(--sim-blue);
  }

  .hero__seam {
    position: absolute;
    inset: 0 auto 0 var(--seam);
    width: 2px;
    z-index: 12;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      rgb(255 34 51 / 0.12),
      var(--red) 24%,
      var(--phos) 76%,
      rgb(0 255 65 / 0.12)
    );
    box-shadow: 0 0 26px rgb(255 34 51 / 0.4);
  }

  /* A real range input keeps the seam keyboard-operable and labelled for
     assistive tech. It is visually hidden rather than stretched over the hero —
     a full-bleed overlay sits on top of the buttons and eats their clicks, and
     paints a resize cursor over the whole thing. The grip is the visual
     affordance, so it takes the focus ring. */
  .hero__range {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    border: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .hero__range:focus-visible ~ .hero__grip {
    outline: 2px solid var(--phos);
    outline-offset: 3px;
  }

  .hero__grip {
    position: absolute;
    top: 50%;
    left: var(--seam);
    transform: translate(-50%, -50%);
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 99px;
    background: #0b0d0e;
    border: 1px solid rgb(255 255 255 / 0.3);
    color: #fff;
    z-index: 13;
    cursor: ew-resize;
    touch-action: none;
    box-shadow: 0 6px 30px rgb(0 0 0 / 0.65);
  }

  .hero__hint {
    position: absolute;
    inset: auto 0 5.5rem 0;
    z-index: 13;
    margin: 0;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgb(150 160 170 / 0.75);
    pointer-events: none;
    mix-blend-mode: difference;
    transition: opacity 0.3s ease;
  }

  .hero[data-touched='true'] .hero__hint {
    opacity: 0;
  }

  .hero__scroll {
    position: absolute;
    inset: auto 0 1.75rem 0;
    z-index: 15;
    width: 40px;
    height: 40px;
    margin-inline: auto;
    display: grid;
    place-items: center;
    border-radius: 99px;
    border: 1px solid rgb(150 160 170 / 0.3);
    color: rgb(150 160 170 / 0.85);
    mix-blend-mode: difference;
    animation: hero-bob 2.6s ease-in-out infinite;
  }

  @keyframes hero-bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(5px);
    }
  }

  /* Narrow: a side-by-side poster has no room, so the seam turns horizontal
     and the two realities stack. */
  @media (max-width: 900px) {
    .hero {
      --seam: 48%;
      /* let the page scroll normally; only the grip starts a drag here */
      touch-action: auto;
      cursor: default;
    }
    .hero__grip {
      cursor: ns-resize;
      width: 52px;
      height: 52px;
    }
    .hero__pane--sim {
      clip-path: inset(0 0 calc(100% - var(--seam)) 0);
    }
    .hero__pane--real::after {
      background: linear-gradient(
        to top,
        rgb(7 9 10 / 0.96) 0%,
        rgb(7 9 10 / 0.9) 42%,
        rgb(7 9 10 / 0.3) 78%,
        rgb(7 9 10 / 0.6) 100%
      );
    }
    .hero__inner {
      width: auto;
      left: clamp(1.25rem, 5vw, 2.5rem);
      right: clamp(1.25rem, 5vw, 2.5rem);
      top: auto;
      transform: none;
    }
    .hero__pane--sim .hero__inner {
      top: 6.5rem;
    }
    .hero__pane--real .hero__inner {
      bottom: 4.5rem;
    }
    .hero__head {
      font-size: clamp(2.25rem, 9vw, 3.25rem);
      margin-bottom: 0.875rem;
    }
    .hero__claim {
      margin-bottom: 1rem;
    }
    .hero__meter {
      margin-bottom: 1.125rem;
    }
    .hero__row {
      grid-template-columns: 5.5rem minmax(2rem, 1fr) auto;
    }
    .hero__seam {
      inset: var(--seam) 0 auto 0;
      width: auto;
      height: 2px;
      background: linear-gradient(
        90deg,
        rgb(255 34 51 / 0.12),
        var(--red) 24%,
        var(--phos) 76%,
        rgb(0 255 65 / 0.12)
      );
    }
    .hero__grip {
      top: var(--seam);
      left: 50%;
    }
    .hero__hint,
    .hero__scroll {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .hero__claim {
      display: none;
    }
    .hero__meter {
      font-size: 0.5625rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__scroll {
      animation: none;
    }
    .hero__bar i {
      animation: none;
    }
  }
</style>

<script>
  const hero = document.querySelector<HTMLElement>('[data-seam-root]');
  if (hero) {
    const range = hero.querySelector<HTMLInputElement>('.hero__range')!;
    const stay = hero.querySelector<HTMLButtonElement>('[data-stay]');
    const canvas = hero.querySelector<HTMLCanvasElement>('.hero__rain')!;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    /* ---- the seam ---- */
    const grip = hero.querySelector<HTMLElement>('.hero__grip')!;
    const vertical = window.matchMedia('(max-width: 900px)');

    const setSeam = (pct: number) => {
      hero.style.setProperty('--seam', `${pct}%`);
      range.value = String(pct);
    };

    /* Keyboard and assistive tech drive the same value. */
    range.addEventListener('input', () => {
      hero.dataset.touched = 'true';
      hero.style.setProperty('--seam', `${range.value}%`);
    });

    /* Dragging is handled on the hero itself, not on an overlay: an element
       stretched across the hero would sit above the buttons and swallow every
       click meant for them. */
    let dragging = false;

    const pctFrom = (e: PointerEvent) => {
      const r = hero.getBoundingClientRect();
      const raw = vertical.matches
        ? ((e.clientY - r.top) / r.height) * 100
        : ((e.clientX - r.left) / r.width) * 100;
      return Math.max(8, Math.min(92, raw));
    };

    hero.addEventListener('pointerdown', (e) => {
      const target = e.target as HTMLElement;
      /* never steal a click from a link or a button */
      if (target.closest('a, button')) return;
      /* on narrow screens the seam and the page scroll share an axis, so only
         the grip starts a drag */
      if (vertical.matches && !target.closest('.hero__grip')) return;

      /* stops the browser starting a text selection or a drag image */
      e.preventDefault();

      dragging = true;
      hero.dataset.touched = 'true';
      hero.dataset.dragging = 'true';
      hero.setPointerCapture(e.pointerId);
      setSeam(pctFrom(e));
    });

    hero.addEventListener('pointermove', (e) => {
      if (dragging) setSeam(pctFrom(e));
    });

    const endDrag = () => {
      dragging = false;
      delete hero.dataset.dragging;
      /* clear anything the browser managed to select before preventDefault ran */
      const sel = window.getSelection();
      if (sel && !sel.isCollapsed && hero.contains(sel.anchorNode)) sel.removeAllRanges();
    };
    hero.addEventListener('pointerup', endDrag);
    hero.addEventListener('pointercancel', endDrag);

    /* the grip is the affordance on narrow screens, so give it focus styling */
    grip.addEventListener('pointerdown', () => range.focus({ preventScroll: true }));

    const glideTo = (target: number) => {
      const from = Number(range.value);
      const start = performance.now();
      const step = (now: number) => {
        const t = Math.min((now - start) / 520, 1);
        const eased = 1 - Math.pow(1 - t, 3);
        setSeam(from + (target - from) * eased);
        if (t < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    };

    /* Choosing the blue pill really does put you in the simulation. */
    stay?.addEventListener('click', () => {
      /* delegate to the header's blue pill so there is one code path for
         choosing a reality, and one place that persists it */
      document.querySelector<HTMLButtonElement>('[data-world-set="sim"]')?.click();
    });

    /* Choosing a pill anywhere on the page uncovers that reality here. Without
       this, picking blue leaves the simulation covering the download button with
       no way back except dragging. */
    document.documentElement.addEventListener('worldchange', (e) => {
      const { world, userInitiated } = (e as CustomEvent).detail;
      if (!userInitiated) return;
      hero.dataset.touched = 'true';
      const target = world === 'sim' ? 88 : 24;
      if (reduced) setSeam(target);
      else glideTo(target);
    });

    /* A slow sway before first interaction, so the control announces itself. */
    if (!reduced) {
      const t0 = performance.now();
      const sway = (now: number) => {
        if (hero.dataset.touched === 'true') return;
        setSeam(50 + Math.sin((now - t0) / 2600) * 11);
        requestAnimationFrame(sway);
      };
      requestAnimationFrame(sway);
    }

    /* ---- rain, on the real side only ---- */
    const GLYPHS = 'ｱｲｳｴｵｶｷｸｹｺｻｼｽｾｿﾀﾁﾂﾃﾄﾅﾆﾇﾈﾉﾊﾋﾌﾍﾎﾏﾐﾑﾒﾓﾔﾕﾖﾗﾘﾙﾚﾛﾜﾝ0123456789:.=*+-<>';
    const ctx = canvas.getContext('2d', { alpha: false });

    if (ctx && !reduced) {
      const STEP = 18;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      let w = 0;
      let h = 0;
      let drops: number[] = [];

      const resize = () => {
        const r = canvas.getBoundingClientRect();
        if (!r.width || !r.height) return;
        w = r.width;
        h = r.height;
        canvas.width = Math.floor(w * dpr);
        canvas.height = Math.floor(h * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        ctx.fillStyle = '#07090a';
        ctx.fillRect(0, 0, w, h);
        drops = Array.from({ length: Math.ceil(w / STEP) }, () => Math.random() * -h);
      };

      let last = 0;
      const draw = (now: number) => {
        if (now - last >= 60) {
          last = now;
          ctx.fillStyle = 'rgba(7,9,10,0.11)';
          ctx.fillRect(0, 0, w, h);
          ctx.font = `${STEP}px 'JetBrains Mono Variable', monospace`;
          ctx.textBaseline = 'top';
          for (let i = 0; i < drops.length; i++) {
            const x = i * STEP;
            ctx.fillStyle = 'rgba(185,255,203,0.85)';
            ctx.fillText(GLYPHS[(Math.random() * GLYPHS.length) | 0], x, drops[i]);
            ctx.fillStyle = 'rgba(0,255,65,0.5)';
            ctx.fillText(GLYPHS[(Math.random() * GLYPHS.length) | 0], x, drops[i] - STEP);
            drops[i] += 11;
            if (drops[i] > h && Math.random() > 0.975) drops[i] = -STEP * 2;
          }
        }
        raf = requestAnimationFrame(draw);
      };

      let raf = 0;
      resize();
      raf = requestAnimationFrame(draw);

      let rt: number;
      window.addEventListener('resize', () => {
        clearTimeout(rt);
        rt = window.setTimeout(resize, 160);
      });

      /* stop burning frames once the hero is scrolled past */
      new IntersectionObserver(
        ([entry]) => {
          if (entry.isIntersecting) {
            if (!raf) raf = requestAnimationFrame(draw);
          } else {
            cancelAnimationFrame(raf);
            raf = 0;
          }
        },
        { threshold: 0.02 }
      ).observe(hero);
    }
  }
</script>
