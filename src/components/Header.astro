---
import { Icon } from 'astro-icon/components';
import ThemeToggle from '~/components/ThemeToggle.astro';
import { NAV, LINKS, SITE, REPO } from '~/data/site';

const path = Astro.url.pathname;
const isCurrent = (href: string) => href !== '/' && !href.startsWith('/#') && path.startsWith(href);
---

<header class="site-header">
  <div class="u-shell site-header__inner">
    <a href="/" class="brand" aria-label={`${SITE.name} home`}>
      <img class="brand__mark" src="/images/robrix-logo.png" alt="" width="28" height="28" />
      <span class="brand__word">Robrix</span>
    </a>

    <nav class="site-nav" aria-label="Main">
      {
        NAV.map((item) => (
          <a href={item.href} class="site-nav__link" aria-current={isCurrent(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="site-header__actions">
      <ThemeToggle />
      <a
        href={LINKS.github}
        class="site-header__gh"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Robrix on GitHub — ${REPO.stars} stars`}
      >
        <Icon name="tabler:brand-github" width="17" height="17" />
        <span class="site-header__stars">
          <Icon name="tabler:star-filled" width="11" height="11" />
          {REPO.stars}
        </span>
      </a>
      <button type="button" class="site-header__menu" aria-expanded="false" aria-controls="mobile-nav">
        <Icon name="tabler:menu-2" width="20" height="20" />
        <span class="sr-only">Menu</span>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" class="mobile-nav" aria-label="Main" hidden>
    <div class="u-shell mobile-nav__inner">
      {NAV.map((item) => <a href={item.href}>{item.label}</a>)}
      <a href={LINKS.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
    </div>
  </nav>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 100;
    background: color-mix(in srgb, var(--w-bg) 82%, transparent);
    backdrop-filter: blur(14px) saturate(1.4);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
    border-bottom: 1px solid transparent;
    transition:
      border-color 0.25s ease,
      background-color 0.25s ease;
  }

  .site-header[data-scrolled='true'] {
    border-bottom-color: var(--w-line);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: 4rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-right: auto;
    flex: 0 0 auto;
  }

  .brand img {
    width: 28px;
    height: 28px;
  }

  .brand__word {
    font-family: var(--font-display);
    font-size: 1.25rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--w-text);
  }

  .site-nav {
    display: none;
    gap: 1.5rem;
  }

  .site-nav__link {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: var(--w-dim);
    transition: color 0.16s ease;
    position: relative;
  }

  .site-nav__link:hover,
  .site-nav__link[aria-current='page'] {
    color: var(--w-text);
  }

  .site-nav__link[aria-current='page']::after {
    content: '';
    position: absolute;
    inset: auto 0 -0.5rem 0;
    height: 1px;
    background: var(--w-phos);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    flex: 0 0 auto;
  }

  /* The repo is the main call to action for this audience, so it reads as a
     button carrying its star count rather than a grey glyph. */
  .site-header__gh {
    display: none;
    align-items: center;
    gap: 0.5rem;
    height: 34px;
    padding: 0 0.75rem;
    border: 1px solid color-mix(in srgb, var(--w-phos) 34%, var(--w-line));
    border-radius: 99px;
    background: var(--w-phos-soft);
    color: var(--w-text);
    transition:
      color 0.18s ease,
      border-color 0.18s ease,
      background-color 0.18s ease,
      box-shadow 0.18s ease,
      transform 0.18s ease;
  }

  .site-header__stars {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
    color: var(--w-phos);
    padding-left: 0.5rem;
    border-left: 1px solid color-mix(in srgb, var(--w-phos) 26%, transparent);
  }

  .site-header__gh:hover {
    border-color: var(--w-phos);
    background: color-mix(in srgb, var(--w-phos) 14%, transparent);
    box-shadow: var(--w-glow);
    transform: translateY(-1px);
  }

  .site-header__menu {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border: 1px solid var(--w-line);
    border-radius: 6px;
    background: transparent;
    color: var(--w-dim);
    cursor: pointer;
  }

  .mobile-nav {
    border-top: 1px solid var(--w-line);
    background: var(--w-bg);
  }

  .mobile-nav__inner {
    display: flex;
    flex-direction: column;
    padding-block: 0.5rem 1rem;
  }

  .mobile-nav a {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--w-dim);
    padding-block: 0.75rem;
    border-bottom: 1px solid var(--w-line);
  }

  .mobile-nav a:last-child {
    border-bottom: 0;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (min-width: 900px) {
    .site-nav {
      display: flex;
    }
    .site-header__gh {
      display: inline-flex;
    }
    .site-header__menu {
      display: none;
    }
    .mobile-nav {
      display: none;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('.site-header')!;
  const toggle = header.querySelector<HTMLButtonElement>('.site-header__menu')!;
  const panel = document.getElementById('mobile-nav')!;

  toggle.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    panel.hidden = open;
  });

  panel.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      toggle.setAttribute('aria-expanded', 'false');
      panel.hidden = true;
    })
  );

  const onScroll = () => {
    header.dataset.scrolled = String(window.scrollY > 8);
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>
