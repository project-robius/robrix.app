---
import { Icon } from 'astro-icon/components';
import SectionHead from '~/components/SectionHead.astro';
import { SIGNATURE } from '~/data/site';
---

<section id="dock" class="u-section dock">
  <div class="u-grid-bg" aria-hidden="true"></div>
  <div class="u-shell">
    <SectionHead
      eyebrow="Your conversations, your layout"
      title="A little more room to talk."
      lede="Keep a thread beside its room, follow a few conversations together, or give one room your full attention. Split, stack and drag tabs into place — Robrix remembers your layout."
    />

    <figure class="dock__shot">
      <div class="dock__frame">
        <img
          src="/images/robrix-desktop-light.webp"
          alt="Robrix on desktop in the light theme: a rooms list with filter bubbles on the left, and several docked room panes with their own tabs, a thread and a members list."
          width="2000"
          height="1299"
          loading="lazy"
          decoding="async"
        />
      </div>
      <figcaption>Desktop multi-room view in the light theme.</figcaption>
    </figure>

    <ul class="dock__points">
      {
        SIGNATURE.map((item) => (
          <li class="dock__point">
            <Icon name={item.icon} width="22" height="22" />
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .dock {
    border-top: 1px solid var(--w-line);
  }

  /* held a little inside the shell and centred, so the window reads as an object
     sitting in the section rather than a band running edge to edge */
  .dock__shot {
    max-width: 64rem;
    margin: 0 auto clamp(2.5rem, 5vw, 4rem);
  }

  /* The screenshot carries its own window shadow; a phosphor glow ties it to the code rain. */
  .dock__frame {
    filter: drop-shadow(0 0 28px color-mix(in srgb, var(--w-phos) 14%, transparent));
  }

  .dock__shot img {
    width: 100%;
  }

  .dock__shot figcaption {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    color: var(--w-faint);
    margin-top: 0.875rem;
  }

  .dock__points {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.5rem;
  }

  .dock__point {
    border-top: 1px solid var(--w-line);
    padding-top: 1.25rem;
  }

  .dock__point :global(svg) {
    color: var(--w-phos);
    margin-bottom: 0.875rem;
  }

  .dock__point h3 {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--w-text);
    margin: 0 0 0.5rem;
  }

  .dock__point p {
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 300;
    color: var(--w-dim);
  }

  @media (min-width: 820px) {
    .dock__points {
      grid-template-columns: repeat(3, 1fr);
      gap: 2.5rem;
    }
  }
</style>
