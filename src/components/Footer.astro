---
import { Icon } from 'astro-icon/components';
import { LINKS, REPO, RELEASE } from '~/data/site';

const columns = [
  {
    title: 'Robrix',
    links: [
      { label: 'Download', href: '/download' },
      { label: 'Features', href: '/#features' },
      { label: 'Platforms', href: '/#platforms' },
      { label: 'Talks & videos', href: '/presentations' },
      { label: 'Privacy policy', href: '/privacy' },
    ],
  },
  {
    title: 'Source',
    links: [
      { label: 'GitHub repository', href: LINKS.github },
      { label: 'Releases', href: LINKS.releases },
      { label: 'Issues', href: LINKS.issues },
      { label: 'MIT licence', href: LINKS.license },
    ],
  },
  {
    title: 'Community',
    links: [
      { label: '#robius-robrix:matrix.org', href: LINKS.matrixRoom },
      { label: '#robius:matrix.org', href: LINKS.matrixGeneral },
      { label: 'Project Robius', href: LINKS.robius },
      { label: 'Makepad', href: LINKS.makepad },
    ],
  },
];
---

<footer class="site-footer">
  <div class="u-shell">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <a href="/" class="brand">
          <img class="brand__mark" src="/images/robrix-logo.png" alt="" width="32" height="32" />
          <span class="brand__word">Robrix</span>
        </a>
        <p class="site-footer__blurb">
          A Matrix chat client written from scratch in Rust, built on the Makepad UI toolkit and Project Robius.
        </p>
        <div class="site-footer__meta">
          <span class="u-chip">{RELEASE.tag}</span>
          <span class="u-chip">{REPO.stars} ★</span>
          <span class="u-chip">{REPO.license}</span>
        </div>
      </div>

      {
        columns.map((col) => (
          <nav class="site-footer__col" aria-label={col.title}>
            <h2 class="u-label">{col.title}</h2>
            <ul>
              {col.links.map((l) => (
                <li>
                  <a
                    href={l.href}
                    target={l.href.startsWith('http') ? '_blank' : undefined}
                    rel={l.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                  >
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div class="site-footer__bottom">
      <p>
        Open source under the MIT licence. Part of <a href={LINKS.robius} target="_blank" rel="noopener noreferrer"
          >Project Robius</a
        >.
      </p>
      <div class="site-footer__social">
        <a href={LINKS.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub">
          <Icon name="tabler:brand-github" width="18" height="18" />
        </a>
        <a href={LINKS.matrixRoom} target="_blank" rel="noopener noreferrer" aria-label="Matrix room">
          <Icon name="tabler:message-circle" width="18" height="18" />
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--w-line);
    background: var(--w-sunken);
    padding-block: clamp(3rem, 6vw, 4.5rem) 2rem;
  }

  .site-footer__top {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  .site-footer__brand {
    max-width: 34ch;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .brand__word {
    font-family: var(--font-display);
    font-size: 1.375rem;
    text-transform: uppercase;
    color: var(--w-text);
  }

  .site-footer__blurb {
    color: var(--w-dim);
    font-size: 0.9375rem;
    font-weight: 300;
    margin: 0.875rem 0 1.125rem;
  }

  .site-footer__meta {
    display: flex;
    gap: 0.375rem;
    flex-wrap: wrap;
  }

  .site-footer__col ul {
    list-style: none;
    margin: 0.875rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .site-footer__col a {
    font-size: 0.875rem;
    color: var(--w-dim);
    transition: color 0.16s ease;
  }

  .site-footer__col a:hover {
    color: var(--w-phos);
  }

  .site-footer__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--w-line);
  }

  .site-footer__bottom p {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--w-faint);
  }

  .site-footer__bottom a {
    color: var(--w-dim);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .site-footer__social {
    display: flex;
    gap: 0.5rem;
  }

  .site-footer__social a {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border: 1px solid var(--w-line);
    border-radius: 99px;
    color: var(--w-dim);
    transition:
      color 0.16s ease,
      border-color 0.16s ease;
  }

  .site-footer__social a:hover {
    color: var(--w-text);
    border-color: var(--w-line-strong);
  }

  @media (min-width: 780px) {
    .site-footer__top {
      grid-template-columns: 1.4fr repeat(3, 1fr);
      gap: 3rem;
    }
  }
</style>
