---
import { Icon } from 'astro-icon/components';
import SectionHead from '~/components/SectionHead.astro';
import { TARGETS, BUILDS } from '~/data/site';

const ready = TARGETS.filter((t) => t.status === 'ready').length;
---

<section id="platforms" class="u-section platforms">
  <div class="u-shell">
    <SectionHead
      eyebrow="One crate, every target"
      title="No platform-specific code"
      lede="Not a shared core with native shells bolted on top. The same Rust, the same UI, compiled for a different target — here is the whole of it."
    />

    <div class="build">
      <ol class="build__list">
        {
          BUILDS.map((b) => (
            <li class="build__row">
              <div class="build__meta">
                <span class="build__target">{b.target}</span>
                <span class="build__detail">{b.detail}</span>
              </div>
              <div class="build__cmd">
                <code>
                  <span class="build__prompt">$</span>
                  {b.command}
                </code>
                <button type="button" class="build__copy" data-copy={b.command} aria-label={`Copy the ${b.target} build command`}>
                  <Icon name="tabler:copy" width="14" height="14" />
                </button>
              </div>
            </li>
          ))
        }
      </ol>

      <p class="build__foot">
        <Icon name="tabler:git-branch" width="14" height="14" />
        <span>One crate. One source tree. No per-platform forks to keep in step.</span>
      </p>
    </div>

    <ul class="pf-chips" aria-label={`${ready} platforms shipping, ${TARGETS.length - ready} in progress`}>
      {
        TARGETS.map((t) =>
          t.download ? (
            <li>
              <a class="pf-chip" href={`/download#${t.download}`} data-status={t.status}>
                <Icon name={t.icon} width="15" height="15" />
                <span class="pf-chip__name">{t.name}</span>
                <Icon name="tabler:arrow-down" width="12" height="12" class="pf-chip__go" />
              </a>
            </li>
          ) : (
            <li class="pf-chip" data-status={t.status}>
              <Icon name={t.icon} width="15" height="15" />
              <span class="pf-chip__name">{t.name}</span>
              <span class="pf-chip__wip">in progress</span>
            </li>
          )
        )
      }
    </ul>

    <p class="pf-getit">
      Every one of those is a build you can install today.{' '}
      <a href="/download">See all downloads →</a>
    </p>
  </div>
</section>

<style>
  .platforms {
    border-top: 1px solid var(--w-line);
  }

  /* ---- the proof: one crate, three targets ---- */
  .build {
    border: 1px solid var(--w-line);
    border-radius: 8px;
    background: var(--w-raised);
    overflow: hidden;
  }

  .build__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .build__row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.625rem;
    padding: 1rem 1.125rem;
    border-bottom: 1px solid var(--w-line);
  }

  .build__meta {
    display: flex;
    align-items: baseline;
    gap: 0.625rem;
    flex-wrap: wrap;
  }

  .build__target {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--w-text);
  }

  .build__detail {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--w-faint);
  }

  .build__cmd {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
    background: var(--w-bg);
    border: 1px solid var(--w-line);
    border-radius: 5px;
    padding: 0.5rem 0.5rem 0.5rem 0.75rem;
  }

  .build__cmd code {
    flex: 1 1 auto;
    min-width: 0;
    overflow-x: auto;
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--w-text);
    scrollbar-width: thin;
  }

  .build__prompt {
    color: var(--w-phos);
    user-select: none;
    margin-right: 0.5rem;
  }

  .build__copy {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border: 1px solid var(--w-line);
    border-radius: 4px;
    background: transparent;
    color: var(--w-faint);
    cursor: pointer;
    transition:
      color 0.16s ease,
      border-color 0.16s ease;
  }

  .build__copy:hover {
    color: var(--w-phos);
    border-color: var(--w-phos);
  }

  .build__copy[data-copied='true'] {
    color: var(--w-phos);
    border-color: var(--w-phos);
  }

  .build__foot {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    padding: 0.875rem 1.125rem;
    background: var(--w-phos-soft);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    color: var(--w-phos);
  }

  .build__foot :global(svg) {
    flex: 0 0 auto;
  }

  /* ---- what that gets you ---- */
  .pf-chips {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .pf-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4375rem;
    padding: 0.4375rem 0.75rem;
    border: 1px solid color-mix(in srgb, var(--w-phos) 26%, var(--w-line));
    border-radius: 99px;
    background: var(--w-phos-soft);
    font-size: 0.8125rem;
    color: var(--w-text);
  }

  .pf-chip :global(svg) {
    color: var(--w-phos);
  }

  .pf-chip[data-status='wip'] {
    border-color: var(--w-line);
    background: transparent;
    color: var(--w-dim);
  }

  .pf-chip[data-status='wip'] :global(svg) {
    color: var(--w-faint);
  }

  .pf-chip__wip {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--w-faint);
    padding-left: 0.4375rem;
    border-left: 1px solid var(--w-line);
  }

  .pf-chip__go {
    color: var(--w-faint);
    margin-left: 0.125rem;
    transition:
      transform 0.16s ease,
      color 0.16s ease;
  }

  a.pf-chip:hover {
    border-color: var(--w-phos);
    background: color-mix(in srgb, var(--w-phos) 14%, transparent);
  }

  a.pf-chip:hover .pf-chip__go {
    color: var(--w-phos);
    transform: translateY(2px);
  }

  .pf-getit {
    margin: 1.125rem 0 0;
    font-size: 0.875rem;
    font-weight: 300;
    color: var(--w-dim);
  }

  .pf-getit a {
    color: var(--w-phos);
    margin-left: 0.375rem;
    border-bottom: 1px solid color-mix(in srgb, var(--w-phos) 40%, transparent);
    padding-bottom: 1px;
  }

  .pf-getit a:hover {
    border-bottom-color: var(--w-phos);
  }

  @media (min-width: 44rem) {
    .build__row {
      grid-template-columns: 13rem minmax(0, 1fr);
      gap: 1.25rem;
      align-items: center;
    }

    .build__meta {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.1875rem;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('.build__copy').forEach((btn) => {
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? '');
        btn.dataset.copied = 'true';
        window.setTimeout(() => delete btn.dataset.copied, 1400);
      } catch {
        /* clipboard blocked (insecure context, or the user denied it) —
           the command is selectable in the block either way */
      }
    });
  });
</script>
