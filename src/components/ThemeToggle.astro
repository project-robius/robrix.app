---
import { Icon } from 'astro-icon/components';
---

<label class="theme-control">
  <Icon name="tabler:sun-moon" width="16" height="16" />
  <select aria-label="Color theme" data-theme-select>
    <option value="dark">Dark</option>
    <option value="light">Light</option>
    <option value="system">System</option>
  </select>
</label>

<style>
  .theme-control {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding-left: 0.625rem;
    border: 1px solid var(--w-line-strong);
    border-radius: 4px;
    background: var(--w-raised);
    color: var(--w-dim);
  }

  .theme-control :global(svg) {
    flex: 0 0 auto;
    color: var(--w-phos);
  }

  select {
    min-height: 36px;
    padding: 0.375rem 0.25rem;
    border: 0;
    background: var(--w-raised);
    color: var(--w-text);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    cursor: pointer;
  }
</style>

<script>
  const control = document.querySelector<HTMLSelectElement>('[data-theme-select]');
  const root = document.documentElement;
  const system = window.matchMedia('(prefers-color-scheme: dark)');

  if (control) {
    control.value = root.dataset.themePreference || 'dark';

    const apply = () => {
      const preference = control.value;
      root.dataset.themePreference = preference;
      root.dataset.theme = preference === 'system' ? (system.matches ? 'dark' : 'light') : preference;
    };

    control.addEventListener('change', () => {
      apply();
      try {
        localStorage.setItem('robrix-theme', control.value);
      } catch {
        // The theme still works when the browser disables storage.
      }
    });
    system.addEventListener('change', () => {
      if (control.value === 'system') apply();
    });
  }
</script>
