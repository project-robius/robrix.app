---
import { Icon } from 'astro-icon/components';
import SectionHead from '~/components/SectionHead.astro';
import { DIFFERENCE } from '~/data/site';
---

<section id="difference" class="diff u-section">
  <div class="u-shell">
    <SectionHead
      eyebrow="The difference"
      title="Built like nothing else on Matrix"
      lede="Robrix's dockable-tab layout is new to the Matrix ecosystem — it is the reason the project exists in the form it does. Here is how it lines up against the pattern most Matrix clients follow."
    />

    <div class="u-scroll-x diff__scroller">
      <table class="diff__table">
        <caption class="sr-only">How Robrix compares with the typical Matrix client</caption>
        <colgroup>
          <col class="diff__col-axis" />
          <col class="diff__col-typical" />
          <col class="diff__col-robrix" />
        </colgroup>
        <thead>
          <tr>
            <th scope="col"><span class="sr-only">Capability</span></th>
            <th scope="col" class="diff__head diff__head--typical">
              <span class="diff__pill diff__pill--blue"></span>
              A typical Matrix client
            </th>
            <th scope="col" class="diff__head diff__head--robrix">
              <span class="diff__pill diff__pill--red"></span>
              Robrix
            </th>
          </tr>
        </thead>
        <tbody>
          {
            DIFFERENCE.map((row) => (
              <tr>
                <th scope="row" class="diff__axis">
                  <span class="diff__axis-name">{row.axis}</span>
                  <span class="diff__axis-note">{row.note}</span>
                </th>
                <td class="diff__cell diff__cell--typical" data-label="Typical">
                  <span class="diff__mark diff__mark--no">
                    <Icon name="tabler:x" width="11" height="11" />
                  </span>
                  <span>{row.typical}</span>
                </td>
                <td class="diff__cell diff__cell--robrix" data-label="Robrix">
                  <span class="diff__mark diff__mark--yes">
                    <Icon name="tabler:check" width="11" height="11" />
                  </span>
                  <span>{row.robrix}</span>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <p class="diff__caveat">
      <Icon name="tabler:info-circle" width="15" height="15" />
      <span>
        "Typical" describes the common pattern across widely used Matrix clients, not every client in the
        ecosystem — it is a big ecosystem and we have not audited all of it. If your client does one of these,
        we would genuinely like to hear about it.
      </span>
    </p>
  </div>
</section>

<style>
  .diff {
    border-top: 1px solid var(--w-line);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* separate, not collapse: the Robrix column is a continuous tinted panel with
     rounded ends, and collapsed borders cannot carry a radius. */
  .diff__table {
    width: 100%;
    min-width: 46rem;
    border-collapse: separate;
    border-spacing: 0;
  }

  .diff__col-axis {
    width: 34%;
  }
  .diff__col-typical {
    width: 28%;
  }
  .diff__col-robrix {
    width: 38%;
  }

  .diff__table th,
  .diff__table td {
    text-align: left;
    vertical-align: top;
    padding: 1.125rem 1.25rem;
  }

  /* ---- header ---- */
  .diff__head {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
    padding-block: 0.875rem;
    vertical-align: middle;
  }

  .diff__head--typical {
    color: var(--w-faint);
  }

  .diff__head--robrix {
    color: var(--w-text);
  }

  .diff__pill {
    display: inline-block;
    width: 18px;
    height: 9px;
    border-radius: 99px;
    margin-right: 0.5rem;
    vertical-align: middle;
  }

  .diff__pill--blue {
    background: #3e7bc4;
  }

  .diff__pill--red {
    background: #ff2233;
  }

  /* ---- the Robrix column reads as one lit panel running the table's height ---- */
  .diff__head--robrix,
  .diff__cell--robrix {
    background: color-mix(in srgb, var(--w-phos) 6%, transparent);
    border-inline: 1px solid color-mix(in srgb, var(--w-phos) 22%, transparent);
  }

  .diff__head--robrix {
    border-top: 2px solid var(--w-phos);
    border-radius: 6px 6px 0 0;
  }

  .diff__table tbody tr:last-child .diff__cell--robrix {
    border-bottom: 1px solid color-mix(in srgb, var(--w-phos) 22%, transparent);
    border-radius: 0 0 6px 6px;
  }

  /* ---- rows ---- */
  .diff__table tbody th,
  .diff__table tbody td {
    border-top: 1px solid var(--w-line);
  }

  .diff__axis {
    font-weight: 400;
  }

  .diff__axis-name {
    display: block;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--w-text);
  }

  .diff__axis-note {
    display: block;
    font-size: 0.8125rem;
    font-weight: 300;
    line-height: 1.5;
    color: var(--w-dim);
    margin-top: 0.3125rem;
  }

  .diff__cell {
    font-size: 0.9375rem;
    line-height: 1.45;
  }

  .diff__cell--typical {
    font-weight: 300;
    color: var(--w-faint);
  }

  .diff__cell--robrix {
    font-weight: 600;
    color: var(--w-text);
  }

  .diff__cell > span:last-child {
    display: inline-block;
    vertical-align: top;
  }

  .diff__mark {
    display: inline-grid;
    place-items: center;
    width: 18px;
    height: 18px;
    border-radius: 99px;
    margin-right: 0.5rem;
    vertical-align: top;
    flex: 0 0 auto;
    position: relative;
    top: 1px;
  }

  .diff__mark--no {
    color: var(--w-faint);
    border: 1px solid color-mix(in srgb, var(--w-faint) 45%, transparent);
  }

  .diff__mark--yes {
    color: var(--w-phos-ink);
    background: var(--w-phos);
  }

  /* ---- stacked cards once the three columns stop fitting ---- */
  @media (max-width: 52rem) {
    .diff__scroller {
      overflow-x: visible;
    }

    .diff__table {
      min-width: 0;
      display: block;
    }

    .diff__table thead {
      display: none;
    }

    .diff__table tbody,
    .diff__table tr,
    .diff__table th,
    .diff__table td {
      display: block;
      width: auto;
    }

    .diff__table tr {
      border: 1px solid var(--w-line);
      border-radius: 8px;
      overflow: hidden;
      margin-bottom: 0.75rem;
      background: var(--w-raised);
    }

    .diff__table tbody th,
    .diff__table tbody td {
      border-top: 0;
    }

    .diff__axis {
      padding-bottom: 0.875rem;
      border-bottom: 1px solid var(--w-line) !important;
    }

    .diff__cell {
      display: flex;
      align-items: flex-start;
      gap: 0;
      padding-block: 0.875rem;
    }

    .diff__cell::before {
      content: attr(data-label);
      flex: 0 0 4.75rem;
      font-family: var(--font-mono);
      font-size: 0.5625rem;
      letter-spacing: 0.13em;
      text-transform: uppercase;
      color: var(--w-faint);
      padding-top: 0.25rem;
    }

    .diff__cell--robrix {
      border-inline: 0;
      border-top: 1px solid color-mix(in srgb, var(--w-phos) 22%, transparent) !important;
      border-radius: 0;
    }

    .diff__table tbody tr:last-child .diff__cell--robrix {
      border-bottom: 0;
      border-radius: 0;
    }
  }

  .diff__caveat {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
    margin: 1.75rem 0 0;
    font-size: 0.8125rem;
    font-weight: 300;
    line-height: 1.6;
    color: var(--w-faint);
    max-width: 68ch;
  }

  .diff__caveat :global(svg) {
    flex: 0 0 auto;
    margin-top: 0.1875rem;
  }
</style>
