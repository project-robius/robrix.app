---
import { Icon } from 'astro-icon/components';
import SectionHead from '~/components/SectionHead.astro';
import { FEATURES, ROADMAP, LINKS } from '~/data/site';
---

<section id="features" class="u-section features">
  <div class="u-shell">
    <SectionHead
      eyebrow="What it does"
      title="A real client, not a demo"
      lede="Robrix is in alpha, but it is a client you can actually live in. This is what shipped, not what's planned."
    />

    <ul class="features__grid">
      {
        FEATURES.map((f) => (
          <li class="u-card features__item">
            <Icon name={f.icon} width="22" height="22" />
            <h3>{f.title}</h3>
            <p>{f.body}</p>
          </li>
        ))
      }
    </ul>

    <div class="features__next">
      <div>
        <p class="u-label">On the way</p>
        <h3 class="features__next-title">What's next</h3>
        <p class="features__next-lede">
          Tracked in the open. If something here matters to you, the issue tracker is the place to say so.
        </p>
        <a class="u-btn u-btn--ghost" href={LINKS.issues} target="_blank" rel="noopener noreferrer">
          <Icon name="tabler:external-link" width="16" height="16" />
          Open issues
        </a>
      </div>
      <ul class="features__roadmap">
        {
          ROADMAP.map((item) => (
            <li>
              <Icon name="tabler:point" width="14" height="14" />
              {item}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .features {
    border-top: 1px solid var(--w-line);
    background: var(--w-sunken);
  }

  .features__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
  }

  .features__item :global(svg) {
    color: var(--w-phos);
    margin-bottom: 0.875rem;
  }

  .features__item h3 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--w-text);
    margin: 0 0 0.5rem;
  }

  .features__item p {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 300;
    line-height: 1.6;
    color: var(--w-dim);
  }

  .features__next {
    display: grid;
    gap: 2rem;
    margin-top: clamp(3rem, 6vw, 4.5rem);
    padding-top: clamp(2.5rem, 5vw, 3.5rem);
    border-top: 1px solid var(--w-line);
  }

  .features__next-title {
    font-family: var(--font-display);
    text-transform: uppercase;
    font-weight: 400;
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    line-height: 0.95;
    color: var(--w-text);
    margin: 0.75rem 0 0.75rem;
  }

  .features__next-lede {
    color: var(--w-dim);
    font-weight: 300;
    font-size: 0.9375rem;
    max-width: 38ch;
    margin: 0 0 1.5rem;
  }

  .features__roadmap {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .features__roadmap li {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding-block: 0.8125rem;
    border-bottom: 1px dashed var(--w-line);
    font-size: 0.9375rem;
    font-weight: 300;
    color: var(--w-dim);
  }

  .features__roadmap li:last-child {
    border-bottom: 0;
  }

  .features__roadmap :global(svg) {
    color: var(--w-faint);
    flex: 0 0 auto;
  }

  @media (min-width: 620px) {
    .features__grid {
      /* nine features, so three across — four would leave an orphan row */
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 940px) {
    .features__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 820px) {
    .features__next {
      grid-template-columns: 1fr 1.15fr;
      gap: 4rem;
    }
  }
</style>
