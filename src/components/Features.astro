---
import { Icon } from 'astro-icon/components';
import SectionHead from '~/components/SectionHead.astro';
import { FEATURES, ROADMAP, LINKS } from '~/data/site';
---

<section id="features" class="u-section features">
  <div class="u-shell">
    <SectionHead
      eyebrow="What it does"
      title="A real client, not a demo"
      lede="Robrix is in beta, but it is a client you can actually live in. This is what shipped, not what's planned."
    />

    <ul class="features__dock">
      {
        FEATURES.map((f) => (
          <li class="features__pane">
            <div class="features__tab">
              <span class="features__well">
                <Icon name={f.icon} width="16" height="16" />
              </span>
              <h3>{f.title}</h3>
            </div>
            <p>{f.body}</p>
          </li>
        ))
      }
    </ul>

    <div class="features__next">
      <div>
        <h3 class="features__next-title">What's next</h3>
        <p class="features__next-lede">
          Tracked in the open. If something here matters to you, the issue tracker is the place to say so.
        </p>
        <a class="u-btn u-btn--ghost" href={LINKS.issues} target="_blank" rel="noopener noreferrer">
          <Icon name="tabler:external-link" width="16" height="16" />
          Open issues
        </a>
      </div>
      <ol class="features__queue">
        {
          ROADMAP.map((item, i) => (
            <li class="features__queued" style={`--step: ${i}`}>
              {item.issue ? (
                <a
                  class="features__row"
                  href={`${LINKS.issues}/${item.issue}`}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span class="features__mark" aria-hidden="true" />
                  <span class="features__what">{item.label}</span>
                  <span class="features__issue">#{item.issue}</span>
                </a>
              ) : (
                <span class="features__row">
                  <span class="features__mark" aria-hidden="true" />
                  <span class="features__what">{item.label}</span>
                </span>
              )}
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .features {
    border-top: 1px solid var(--w-line);
    background: var(--w-sunken);
  }

  /* The dock is the thing Robrix is for, so the section listing what shipped is
     built as one: panes sharing seams, not cards floating apart in a grid. A 1px
     gap over a line-coloured bed draws every seam without any nth-child work. */
  .features__dock {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    background: var(--w-line);
    border: 1px solid var(--w-line);
    border-radius: 8px;
    overflow: hidden;
  }

  .features__pane {
    background: var(--w-raised);
    display: flex;
    flex-direction: column;
    transition: background 0.18s ease;
  }

  /* The tab strip a docked pane carries its name on. It runs a shade of phosphor
     even at rest so the dock reads as lit rather than as twelve dark boxes. */
  .features__tab {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.6875rem clamp(0.875rem, 1.8vw, 1.125rem);
    border-bottom: 1px solid var(--w-line);
    background: color-mix(in srgb, var(--w-phos) 4%, var(--w-raised));
    box-shadow: inset 0 1px 0 color-mix(in srgb, var(--w-phos) 10%, transparent);
    transition: background 0.18s ease;
  }

  /* the icon sits in a lit well, the way a tab carries its file-type mark */
  .features__well {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 6px;
    background: var(--w-phos-soft);
    border: 1px solid color-mix(in srgb, var(--w-phos) 24%, transparent);
    transition:
      background 0.18s ease,
      border-color 0.18s ease,
      box-shadow 0.18s ease;
  }

  .features__tab :global(svg) {
    color: var(--w-phos);
  }

  .features__tab h3 {
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--w-text);
  }

  .features__pane p {
    margin: 0;
    padding: clamp(1rem, 2vw, 1.25rem);
    font-size: 0.875rem;
    font-weight: 300;
    line-height: 1.6;
    color: var(--w-dim);
    transition: color 0.18s ease;
  }

  /* focusing a pane in the app lights its tab. so does reaching one here. */
  .features__pane:hover,
  .features__pane:focus-within {
    background: color-mix(in srgb, var(--w-phos) 6%, var(--w-raised));
  }

  .features__pane:hover .features__tab,
  .features__pane:focus-within .features__tab {
    background: color-mix(in srgb, var(--w-phos) 11%, var(--w-raised));
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, var(--w-phos) 30%, transparent),
      inset 0 -1px 0 var(--w-phos);
  }

  .features__pane:hover .features__well,
  .features__pane:focus-within .features__well {
    background: color-mix(in srgb, var(--w-phos) 22%, transparent);
    border-color: color-mix(in srgb, var(--w-phos) 55%, transparent);
    box-shadow: 0 0 18px color-mix(in srgb, var(--w-phos) 30%, transparent);
  }

  .features__pane:hover p,
  .features__pane:focus-within p {
    color: var(--w-text);
  }

  @media (prefers-reduced-motion: reduce) {
    .features__pane,
    .features__pane p,
    .features__tab,
    .features__well {
      transition: none;
    }
  }

  .features__next {
    display: grid;
    gap: 2rem;
    margin-top: clamp(3rem, 6vw, 4.5rem);
    padding-top: clamp(2.5rem, 5vw, 3.5rem);
    border-top: 1px solid var(--w-line);
  }

  .features__next-title {
    font-family: var(--font-display);
    text-transform: uppercase;
    font-weight: 400;
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    line-height: 0.95;
    color: var(--w-text);
    margin: 0.75rem 0 0.75rem;
  }

  .features__next-lede {
    color: var(--w-dim);
    font-weight: 300;
    font-size: 0.9375rem;
    max-width: 38ch;
    margin: 0 0 1.5rem;
  }

  .features__queue {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .features__queued {
    border-bottom: 1px dashed var(--w-line);
  }

  .features__queued:last-child {
    border-bottom: 0;
  }

  .features__row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-block: 0.8125rem;
    font-size: 0.9375rem;
    font-weight: 300;
    color: var(--w-dim);
    text-decoration: none;
  }

  /* The hero rains a bright head glyph and lets the trail decay behind it. The
     queue is ranked — the README sorts it by priority — so it decays the same
     way, and how far out an item sits is legible without numbering it. Only the
     mark fades: the words stay at the body colour the rest of the page uses. */
  .features__mark {
    flex: 0 0 auto;
    width: 3px;
    height: 1.0625rem;
    border-radius: 2px;
    background: var(--w-phos);
    opacity: calc(1 - var(--step) * 0.13);
  }

  .features__queued:first-child .features__mark {
    box-shadow: 0 0 10px color-mix(in srgb, var(--w-phos) 55%, transparent);
  }

  .features__queued:first-child .features__what {
    color: var(--w-text);
    font-weight: 400;
  }

  .features__what {
    transition: color 0.18s ease;
  }

  /* an item with a filed issue is a place you can go; one without is not */
  .features__issue {
    margin-left: auto;
    flex: 0 0 auto;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--w-faint);
    border: 1px solid var(--w-line);
    border-radius: 4px;
    padding: 0.125rem 0.375rem;
    transition:
      color 0.18s ease,
      border-color 0.18s ease;
  }

  a.features__row:hover .features__what,
  a.features__row:focus-visible .features__what {
    color: var(--w-text);
  }

  a.features__row:hover .features__issue,
  a.features__row:focus-visible .features__issue {
    color: var(--w-phos);
    border-color: color-mix(in srgb, var(--w-phos) 45%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .features__issue,
    .features__what {
      transition: none;
    }
  }

  @media (min-width: 620px) {
    .features__dock {
      /* twelve panes, so two across and three across both come out even */
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 940px) {
    .features__dock {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 820px) {
    .features__next {
      grid-template-columns: 1fr 1.15fr;
      gap: 4rem;
    }
  }
</style>
