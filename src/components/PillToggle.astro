---
/**
 * The theme switch, except it isn't presented as one. Blue pill puts you in the
 * simulation (light); red pill is the real world (dark), and it's the default.
 */
---

<div class="pill-toggle" role="group" aria-label="Choose your reality">
  <button type="button" class="pill pill--blue" data-world-set="sim" aria-pressed="false">
    <span class="pill__dot"></span>
    <span class="pill__text">Blue</span>
  </button>
  <button type="button" class="pill pill--red" data-world-set="real" aria-pressed="true">
    <span class="pill__dot"></span>
    <span class="pill__text">Red</span>
  </button>
</div>

<style>
  .pill-toggle {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    padding: 3px;
    border: 1px solid var(--w-line);
    border-radius: 99px;
    background: var(--w-raised);
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    border: 0;
    background: transparent;
    border-radius: 99px;
    padding: 0.3125rem 0.6875rem;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--w-faint);
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .pill__dot {
    width: 16px;
    height: 8px;
    border-radius: 99px;
    background: currentColor;
    opacity: 0.45;
    transition:
      opacity 0.2s ease,
      box-shadow 0.2s ease,
      background-color 0.2s ease;
  }

  .pill:hover {
    color: var(--w-dim);
  }

  .pill--blue[aria-pressed='true'] {
    color: #3e7bc4;
    background: rgb(62 123 196 / 0.12);
  }
  .pill--red[aria-pressed='true'] {
    color: #ff2233;
    background: rgb(255 34 51 / 0.12);
  }

  .pill[aria-pressed='true'] .pill__dot {
    opacity: 1;
    box-shadow: 0 0 14px currentColor;
  }

  /* the label is decoration on a control that reads as two pills */
  @media (max-width: 560px) {
    .pill__text {
      display: none;
    }
    .pill {
      padding: 0.3125rem 0.5rem;
    }
  }
</style>

<script>
  const KEY = 'robrix-world';
  const root = document.documentElement;

  function apply(world: string, userInitiated: boolean) {
    const persist = userInitiated;
    root.dataset.world = world;
    if (persist) {
      try {
        localStorage.setItem(KEY, world);
      } catch {
        /* private browsing — the choice just won't survive the tab */
      }
    }
    document.querySelectorAll<HTMLButtonElement>('[data-world-set]').forEach((btn) => {
      btn.setAttribute('aria-pressed', String(btn.dataset.worldSet === world));
    });
    root.dispatchEvent(new CustomEvent('worldchange', { detail: { world, userInitiated } }));
  }

  document.querySelectorAll<HTMLButtonElement>('[data-world-set]').forEach((btn) => {
    btn.addEventListener('click', () => apply(btn.dataset.worldSet!, true));
  });

  // Sync the buttons to whatever the pre-paint script already decided.
  apply(root.dataset.world === 'sim' ? 'sim' : 'real', false);
</script>
